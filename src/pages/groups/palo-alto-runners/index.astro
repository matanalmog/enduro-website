---
// Palo Alto Runners: עמוד הנחיתה להכנה למרוץ הלילה. מקושר מהכותרת "PALO ALTO RUNNERS" בתפריט.
// התוכן נשלט מ-src/data/palo-alto-night-run.ts.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import YouTubeEmbed from "../../../components/YouTubeEmbed.astro";
import {
  race,
  plans,
  stravaGroupUrl,
  checklist,
  checklistIntro,
  afterRaceCta,
  techniqueVideos,
  racePhotos,
} from "../../../data/palo-alto-night-run";

const showRacePhotos = Date.now() < new Date(`${racePhotos.showUntil}T00:00:00+02:00`).getTime();

const raceDateHe = new Intl.DateTimeFormat("he-IL", { day: "numeric", month: "long", year: "numeric" }).format(
  new Date(`${race.date}T12:00:00`)
);
const heroParts = ["תוכניות האימון", ...(checklist.length > 0 ? ["צ׳קליסט"] : []), "סרטוני טכניקה", "ומה עושים ביום המרוץ"];
const heroText = `הכול במקום אחד: ${heroParts.slice(0, -1).join(", ")} ${heroParts[heroParts.length - 1]}.`;
---

<BaseLayout
  title="Palo Alto Runners: הכנה למרוץ הלילה"
  description="תוכניות האימון, סרטוני טכניקה ומה עושים ביום המרוץ, לקבוצת Palo Alto Runners, בליווי תומר אלמוג, ENDURO."
  canonicalPath="/groups/palo-alto-runners/"
  ogImage="/images/action/ramat-hasharon-group-night.jpg"
>
  <section class="pa-hero">
    <div class="container">
      <div class="pa-eyebrow">PALO ALTO RUNNERS</div>
      <h1>הכנה למרוץ הלילה</h1>
      <p>{heroText}</p>
    </div>
  </section>

  <section class="container pa-section" id="plans">
    <h2>תוכניות האימון</h2>
    <p class="pa-lead">בוחרים את הרמה שלכם. כל תוכנית נמשכת 5 שבועות.</p>
    <div class="pa-plans">
      {plans.map((p) => <a class="btn btn-primary pa-plan" href={p.href}>{p.label}</a>)}
    </div>
    {
      stravaGroupUrl && (
        <p class="pa-strava-top">
          <a class="btn btn-primary pa-strava-btn" href={stravaGroupUrl} target="_blank" rel="noopener">
            הצטרפות לקבוצת הסטרבה שלנו
          </a>
        </p>
      )
    }
  </section>

  <section class="container pa-section" id="countdown">
    <div class="pa-race">
      <div class="pa-clock-wrap">
        <div class="pa-clock" id="pa-clock" data-start={race.startsAt} role="timer" aria-label="הזמן שנשאר עד זינוק המרוץ">
          <div class="pa-unit"><span class="pa-num" data-unit="d">--</span><span class="pa-lbl">ימים</span></div>
          <div class="pa-unit"><span class="pa-num" data-unit="h">--</span><span class="pa-lbl">שעות</span></div>
          <div class="pa-unit"><span class="pa-num" data-unit="m">--</span><span class="pa-lbl">דקות</span></div>
          <div class="pa-unit"><span class="pa-num" data-unit="s">--</span><span class="pa-lbl">שניות</span></div>
        </div>
        <p class="pa-clock-note" id="pa-clock-note">עד זינוק המרוץ הראשון</p>
      </div>
      <div class="pa-race-info">
        <h2>{race.name}</h2>
        <p>{raceDateHe}. מרחקים: {race.distances}.</p>
        <ul class="pa-starts">
          {race.starts.map((st) => <li><strong>{st.distance}:</strong> {st.times}</li>)}
        </ul>
        <p class="pa-starts-note">שעות הזינוק לפי האתר הרשמי של המרוץ. הלו״ז נתון לשינויים.</p>
        <p><a href={race.link} target="_blank" rel="noopener">אתר המרוץ וההרשמה</a></p>
      </div>
    </div>
  </section>

  {
    showRacePhotos && (
      <section class="container pa-section" id="race-photos">
        <figure class="pa-photos">
          {racePhotos.images.map((img) => (
            <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" />
          ))}
          <figcaption>{racePhotos.caption}</figcaption>
        </figure>
      </section>
    )
  }

  {
    checklist.length > 0 && (
      <section class="container pa-section" id="checklist">
        <h2>צ׳קליסט למרוץ לילה: 5 או 10 ק״מ</h2>
        <p class="pa-lead">{checklistIntro}</p>
        <div class="pa-check">
          {checklist.map((sec) => (
            <div class="pa-check-card" id={sec.id}>
              <h3>{sec.title}</h3>
              {sec.blocks.map((block, bi) => (
                <div class="pa-block">
                  {block.title && <h4>{block.title}</h4>}
                  {"intro" in block && block.intro && <p>{block.intro}</p>}
                  {block.kind === "checks" && (
                    <ul class="pa-checks">
                      {block.items.map((item, ii) => (
                        <li>
                          <label>
                            <input type="checkbox" data-check={`${sec.id}-${bi}-${ii}`} />
                            <span>{item}</span>
                          </label>
                        </li>
                      ))}
                    </ul>
                  )}
                  {block.kind === "steps" && (
                    <ol class="pa-steps">
                      {block.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ol>
                  )}
                  {block.kind === "table" && (
                    <div class="pa-table-wrap">
                      <table class="pa-food">
                        <thead>
                          <tr>{block.head.map((h) => <th>{h}</th>)}</tr>
                        </thead>
                        <tbody>
                          {block.rows.map((r) => (
                            <tr>{r.map((c) => <td>{c}</td>)}</tr>
                          ))}
                        </tbody>
                      </table>
                      {block.note && <p class="pa-note">{block.note}</p>}
                    </div>
                  )}
                </div>
              ))}
            </div>
          ))}
        </div>
        <div class="pa-cta">
          <p>{afterRaceCta.text}</p>
          <a class="btn btn-primary" href={afterRaceCta.href}>{afterRaceCta.label}</a>
        </div>
      </section>
    )
  }

  <section class="container pa-section" id="videos">
    <h2>סרטוני טכניקה</h2>
    <p class="pa-lead">שלושה סרטונים קצרים שנוספים לעמוד אחד אחרי השני.</p>
    <div class="pa-videos">
      {
        techniqueVideos.map((v) => (
          <div class="pa-video">
            {v.youtubeId ? (
              <YouTubeEmbed videoId={v.youtubeId} title={v.title} />
            ) : (
              <div class="pa-video-slot" role="img" aria-label={`${v.title}: הסרטון יעלה בקרוב`}>
                <span class="pa-video-title">{v.title}</span>
                <span class="pa-video-soon">יעלה בקרוב</span>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section class="container pa-section pa-join" id="join">
    <h2>נשארים בקשר</h2>
    <div class="pa-join-btns">
      {stravaGroupUrl && <a class="btn btn-primary" href={stravaGroupUrl} target="_blank" rel="noopener">הצטרפות לקבוצת הסטרבה</a>}
      <a class="btn btn-outline" href="https://wa.me/972526982993" target="_blank" rel="noopener">שאלה? וואטסאפ אליי</a>
    </div>
  </section>
</BaseLayout>

<script>
  // סימון הצ׳קליסט נשמר בדפדפן של המשתמש (בלי שרת). אם האחסון חסום, הסימון עובד רק עד רענון הדף.
  const KEY = "palo-alto-night-run-checks";
  let saved: string[] = [];
  try {
    saved = JSON.parse(localStorage.getItem(KEY) || "[]");
  } catch {
    saved = [];
  }
  document.querySelectorAll<HTMLInputElement>("input[data-check]").forEach((box) => {
    const id = box.dataset.check ?? "";
    box.checked = saved.includes(id);
    box.addEventListener("change", () => {
      saved = box.checked ? [...new Set([...saved, id])] : saved.filter((x) => x !== id);
      try {
        localStorage.setItem(KEY, JSON.stringify(saved));
      } catch {
        /* אחסון חסום */
      }
    });
  });
</script>

<script>
  // שעון ספירה לאחור חי עד הזינוק הראשון, מתעדכן כל שנייה
  const clock = document.getElementById("pa-clock");
  const note = document.getElementById("pa-clock-note");
  if (clock?.dataset.start) {
    const target = new Date(clock.dataset.start).getTime();
    const pad = (n: number) => String(n).padStart(2, "0");
    const set = (unit: string, text: string) => {
      const el = clock.querySelector<HTMLElement>(`[data-unit="${unit}"]`);
      if (el) el.textContent = text;
    };
    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) {
        clock.hidden = true;
        if (note) note.textContent = "המרוץ התחיל. בהצלחה לכולם!";
        return false;
      }
      const sec = Math.floor(diff / 1000);
      set("d", String(Math.floor(sec / 86400)));
      set("h", pad(Math.floor((sec % 86400) / 3600)));
      set("m", pad(Math.floor((sec % 3600) / 60)));
      set("s", pad(sec % 60));
      return true;
    };
    if (tick()) {
      const timer = setInterval(() => {
        if (!tick()) clearInterval(timer);
      }, 1000);
    }
  }
</script>

<style is:global>
  .pa-hero {
    background: linear-gradient(180deg, var(--color-navy-950), var(--color-navy-900));
    color: var(--color-white);
    text-align: center;
    padding-block: var(--space-6) var(--space-5);
  }
  .pa-hero .pa-eyebrow {
    color: var(--color-gold-500);
    font-weight: 700;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
  }
  .pa-hero h1 {
    color: var(--color-white);
    margin: 0.4rem 0;
  }
  .pa-hero p {
    color: var(--color-gray-300);
    max-width: 52ch;
    margin-inline: auto;
  }
  .pa-section {
    padding-block: var(--space-4);
  }
  .pa-photos {
    margin: 0;
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-2);
  }
  .pa-photos img {
    width: 100%;
    height: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
  .pa-photos figcaption {
    grid-column: 1 / -1;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .pa-lead {
    color: var(--color-text-muted);
  }
  .pa-plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .pa-plan {
    justify-content: center;
    padding-block: 1rem;
    font-size: 1.1rem;
  }
  .pa-strava-top {
    margin: var(--space-2) 0 0;
  }
  .pa-strava-btn {
    display: flex;
    justify-content: center;
    width: 100%;
    padding-block: 0.9rem;
    font-size: 1.05rem;
  }
  .pa-race {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-lg);
    background: var(--color-gray-50);
  }
  .pa-clock-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }
  .pa-clock {
    display: flex;
    gap: 0.6rem;
    direction: ltr;
  }
  .pa-clock[hidden] {
    display: none;
  }
  .pa-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 4.2rem;
    padding: 0.6rem 0.4rem;
    border-radius: var(--radius-md);
    background: var(--color-navy-950);
    color: var(--color-white);
  }
  .pa-num {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-gold-500);
  }
  .pa-lbl {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    direction: rtl;
  }
  .pa-clock-note {
    margin: 0;
    font-weight: 700;
    color: var(--color-text-muted);
  }
  .pa-starts {
    margin: 0.3rem 0;
    padding-inline-start: 1.1rem;
  }
  .pa-starts-note {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .pa-race-info h2 {
    margin: 0 0 0.3rem;
  }
  .pa-race-info p {
    margin: 0.2rem 0;
  }
  .pa-check {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-3);
    max-width: 760px;
  }
  .pa-check-card {
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-md);
    padding: var(--space-3);
  }
  .pa-check-card h3 {
    margin: 0 0 0.5rem;
  }
  .pa-check-card h4 {
    margin: 0.8rem 0 0.3rem;
    font-size: 1rem;
  }
  .pa-block p {
    margin: 0.3rem 0 0.6rem;
  }
  .pa-checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

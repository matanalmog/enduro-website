    color: var(--color-text-muted);
    text-decoration: line-through;
  }
  .pa-steps {
    margin: 0;
    padding-inline-start: 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .pa-table-wrap {
    overflow-x: auto;
  }
  .pa-food {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.95rem;
  }
  .pa-food th,
  .pa-food td {
    border: 1px solid var(--color-gray-100);

    background: var(--color-gray-50);
  }
  .pa-food td:first-child {
    font-weight: 700;
    white-space: nowrap;
  }
  .pa-note {
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }
  .pa-cta {
    margin-top: var(--space-4);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-navy-950);
    color: var(--color-white);
    text-align: center;
  }
  .pa-cta p {
    color: var(--color-gray-300);
    max-width: 60ch;
    margin: 0 auto var(--space-2);
  }
  .pa-videos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .pa-video-slot {
    aspect-ratio: 16 / 9;
    border: 2px dashed #9ca3af;
    border-radius: 12px;
    background: #f3f4f6;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    color: #374151;
  }
  .pa-video-title {
    font-weight: 700;
  }
  .pa-video-soon {
    font-size: 0.85rem;
    color: #4b5563;
  }
  .pa-join-btns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  @media (max-width: 560px) {
    .pa-plans {
      grid-template-columns: 1fr;
    }
  }
</style>

---
// תבנית משותפת ל-6 עמודי קבוצות הריצה (סעיף 2 באפיון).
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqItem from "../../components/FaqItem.astro";
import TestimonialCard from "../../components/TestimonialCard.astro";
import SectionPhoto from "../../components/SectionPhoto.astro";
import { runningGroups, type RunningGroup } from "../../data/running-groups";

export function getStaticPaths() {
  return runningGroups.map((group) => ({
    params: { slug: group.slug },
    props: { group },
  }));
}

interface Props {
  group: RunningGroup;
}

const { group } = Astro.props;

const otherGroups = runningGroups
  .filter((g) => g.slug !== group.slug)
  .sort((a, b) => a.order - b.order);

const schema = group.faq.length
  ? [
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": group.faq.map((f) => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": { "@type": "Answer", "text": f.a },
        })),
      },
    ]
  : undefined;
---

<BaseLayout
  title={group.title}
  description={group.description}
  canonicalPath={`/groups/${group.slug}/`}
  schema={schema}
>
  <section class="hero">
    <div class="container hero-inner">
      {group.planned && <span class="planned-badge">בתכנון, טרם נפתחה</span>}
      <h1>{group.title}</h1>
      {group.intro.map((p) => <p class="lead">{p}</p>)}
      <div class="hero-actions">
        {group.planned ? (
          <a href="#interest-form" class="btn btn-primary">עדכנו אותי כשהקבוצה תיפתח</a>
        ) : (
          <a href="/#lead-form" class="btn btn-primary">אימון ניסיון / השאירו פרטים</a>
        )}
        <a href="https://wa.me/972526982993" class="btn btn-outline" target="_blank" rel="noopener noreferrer">שלחו וואטסאפ</a>
      </div>
    </div>
  </section>

  {group.image && (
    <section class="container section photo-section">
      <SectionPhoto src={group.image.src} alt={group.image.alt} eager />
    </section>
  )}

  {group.schedule && (
    <section class="container section">
      <h2>לוח זמנים ומבנה האימונים</h2>
      <ul class="plain-list">
        {group.schedule.map((s) => <li>{s}</li>)}
      </ul>
    </section>
  )}

  {group.locations && (
    <section class="container section section-muted">
      <h2>מיקומי האימונים</h2>
      <ul class="location-chips">
        {group.locations.map((l) => <li>{l}</li>)}
      </ul>
    </section>
  )}

  {group.routes && (
    <section class="container section">
      <h2>דוגמאות למסלולי ריצה</h2>
      <div class="three-col">
        {group.routes.map((r) => (
          <div class="feature-card">
            <h3>{r.name}</h3>
            <p>{r.description}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {group.clients && (
    <section class="container section section-muted">
      <h2>ארגונים שכבר איתנו</h2>
      <div class="clients-row">
        {group.clients.map((c) => <span class="client-chip">{c}</span>)}
      </div>
    </section>
  )}

  {group.planned && (
    <section class="container section interest-section" id="interest-form">
      <h2>עדכנו אותי כשהקבוצה תיפתח</h2>
      <p class="section-note">
        השאירו שם וטלפון, ואנחנו נחזור אליכם ברגע שיש מועד פתיחה, ימי
        אימון ומיקום סופיים.
      </p>
      <form
        id="group-interest-form"
        name="group-interest"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/free-plan/thank-you/"
        class="interest-form"
      >
        <input type="hidden" name="form-name" value="group-interest" />
        <input type="hidden" name="group" value={group.slug} />
        <input type="hidden" name="source_page" id="gi-source-page" value="" />
        <p class="hidden-field">
          <label>אל תמלאו שדה זה: <input name="bot-field" /></label>
        </p>

        <div class="field">
          <label for="gi-name">שם מלא *</label>
          <input type="text" id="gi-name" name="name" required />
        </div>

        <div class="field">
          <label for="gi-phone">טלפון *</label>
          <input type="tel" id="gi-phone" name="phone" required pattern="[0-9\-\+\s()]{7,}" title="הזינו מספר טלפון תקין" />
        </div>

        <button type="submit" class="btn btn-primary">עדכנו אותי</button>
        <p class="form-privacy">בשליחת הטופס אתם מאשרים את <a href="/about-me/#privacy">תקנון ומדיניות הפרטיות</a>.</p>
      </form>
    </section>
  )}

  {!group.planned && (
    <section class="container section section-muted">
      <h2>מה מתאמנים אומרים</h2>
      <div class="testimonials-grid">
        <TestimonialCard
          image="/images/testimonials/oshr-zelig.jpg"
          name="אושר זליג"
          quote="3 חודשים של אימון הספיקו לי כדי לנפץ את שיאי בחצי מרתון לאחר 3 שנים של ניסיונות. תומר מסור עד הרגע האחרון."
        />
        <TestimonialCard
          image="/images/testimonials/udi-birkan.jpg"
          name="אודי בירקאן"
          role="מנכ״ל GPS"
          quote="תומר מנחה אותי ומכוון אותי ברגישות והבנה מקצועית, מייעץ לי לתזונה נכונה ואימונים משלימים, וזו הפעם הראשונה יותר משנה וחצי בלי פציעות."
        />
        <TestimonialCard
          name="אורנה אלעד"
          quote="תומר מקצועי ומקסים, מומלץ בחום! גם אימן את אבא שלי בן 80 וגם אותי."
        />
        {group.slug === "trail" && (
          <TestimonialCard
            name="יעל לדר סלומון"
            role="מרוץ UTMR, שטח והרים"
            quote="כל זה לא היה קורה בלי המאמן Tomer Almog שהביא אותי מוכנה פיזית ומנטלית. איזה ליווי והכנה, אין לי מספיק מילים להודות."
          />
        )}
      </div>
    </section>
  )}

  {group.faq.length > 0 && (
    <section class="container section" id="faq">
      <h2>שאלות נפוצות</h2>
      <div class="faq-list">
        {group.faq.map((f) => (
          <FaqItem question={f.q}>
            <p>{f.a}</p>
          </FaqItem>
        ))}
      </div>
    </section>
  )}

  <section class="container section section-muted">
    <h2>קבוצות ריצה נוספות</h2>
    <div class="groups-grid">
      {otherGroups.map((g) => (
        <a href={`/groups/${g.slug}/`} class="group-card">
          <h3>{g.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <section class="container section cta-band">
    {group.planned ? (
      <>
        <h2>רוצים להיות הראשונים לדעת?</h2>
        <p>השאירו פרטים ונעדכן אתכם ברגע שהקבוצה תיפתח.</p>
        <div class="cta-actions">
          <a href="#interest-form" class="btn btn-primary">עדכנו אותי</a>
          <a href="https://wa.me/972526982993" class="btn btn-outline" target="_blank" rel="noopener noreferrer">שלחו וואטסאפ</a>
        </div>
      </>
    ) : (
      <>
        <h2>בואו נתחיל עוד היום!</h2>
        <p>אימון ניסיון ראשון, ללא התחייבות.</p>
        <div class="cta-actions">
          <a href="/#lead-form" class="btn btn-primary">השאירו פרטים</a>
          <a href="https://wa.me/972526982993" class="btn btn-outline" target="_blank" rel="noopener noreferrer">שלחו וואטסאפ</a>
        </div>
      </>
    )}
  </section>
</BaseLayout>

<script>
  // מקור פנייה: אותו מנגנון כמו בעמוד הבית - קודם ?src= בעמוד הנוכחי, אחרת הערך
  // שנשמר ב-localStorage על ידי BaseLayout.astro (בתוקף 30 יום).
  function getStoredLeadSource(): string {
    try {
      const raw = localStorage.getItem("enduro_lead_source");
      if (!raw) return "";
      const parsed = JSON.parse(raw) as { value?: string; ts?: number };
      const THIRTY_DAYS_MS = 30 * 24 * 60 * 60 * 1000;
      if (!parsed.ts || Date.now() - parsed.ts > THIRTY_DAYS_MS) return "";
      return parsed.value ?? "";
    } catch {
      return "";
    }
  }

  const sourcePageField = document.getElementById("gi-source-page") as HTMLInputElement | null;
  if (sourcePageField) {
    const urlSrc = new URLSearchParams(window.location.search).get("src");
    sourcePageField.value = urlSrc || getStoredLeadSource();
  }
</script>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-navy-950), var(--color-navy-900));
    color: var(--color-white);
  }

  .hero-inner {
    padding-block: var(--space-6) var(--space-5);
    max-width: 760px;
    margin-inline: auto;
    text-align: right;
  }

  .hero h1 {
    color: var(--color-white);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    text-wrap: pretty;
  }

  .hero .lead {
    color: var(--color-gray-300);
    font-size: 1.05rem;
  }

  .planned-badge {
    display: inline-block;
    background: var(--color-gold-500);
    color: var(--color-navy-950);
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    margin-bottom: var(--space-2);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    margin-top: var(--space-3);
  }

  .hero .btn-outline {
    color: var(--color-white);
  }

  .section {
    padding-block: var(--space-5);
  }

  .photo-section {
    padding-block: var(--space-4) 0;
    max-width: 900px;
  }

  .photo-section :global(.section-photo img) {
    aspect-ratio: 16 / 9;
  }

  .section-muted {
    background: var(--color-gray-50);
  }

  .plain-list {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-white);
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .plain-list li {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-gray-100);
    font-size: 0.95rem;
  }

  .plain-list li:last-child {
    border-bottom: none;
  }

  .location-chips {
    max-width: 720px;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .location-chips li {
    background: var(--color-white);
    border: 1px solid var(--color-gray-100);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-navy-950);
  }

  .three-col {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .feature-card {
    background: var(--color-white);
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-md);
    padding: var(--space-3);
  }

  .feature-card h3 {
    font-size: 1.05rem;
  }

  .feature-card p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .interest-section {
    max-width: 480px;
    margin-inline: auto;
    text-align: center;
  }

  .interest-section .section-note {
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .interest-form {
    text-align: right;
  }

  .hidden-field {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .interest-form .field {
    margin-bottom: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .interest-form label {
    font-weight: 600;
    font-size: 0.92rem;
  }

  .interest-form input {
    font: inherit;
    padding: 0.7rem 0.9rem;
    border: 1.5px solid var(--color-gray-100);
    border-radius: var(--radius-md);
    background: var(--color-gray-50);
    color: var(--color-text);
  }

  .interest-form input:focus {
    outline: none;
    border-color: var(--color-brand);
    background: var(--color-white);
    box-shadow: 0 0 0 3px var(--color-orange-100);
  }

  .interest-form button {
    width: 100%;
  }

  .form-privacy {
    margin-top: var(--space-2);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  .clients-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .client-chip {
    background: var(--color-white);
    border: 1px solid var(--color-gray-100);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .price-card {
    background: var(--color-gray-50);
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    max-width: 320px;
  }

  .price {
    color: var(--color-brand-hover);
    font-weight: 800;
    font-size: 1.3rem;
    margin: 0 0 0.25rem;
  }

  .price-note {
    color: var(--color-text-muted);
    margin: 0;
    font-size: 0.9rem;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }

  .testimonials-grid :global(.testimonial-card) {
    padding: var(--space-4) var(--space-3);
  }

  .testimonials-grid :global(.testimonial-card:not(:has(img))) {
    padding-top: calc(var(--space-4) + 56px + var(--space-2));
  }

  .testimonials-grid :global(.testimonial-card blockquote p) {
    font-size: 1rem;
    line-height: 1.6;
  }

  .faq-list {
    max-width: 760px;
  }

  .groups-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-2);
  }

  .group-card {
    display: block;
    background: var(--color-white);
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .group-card:hover,
  .group-card:focus-visible {
    border-color: var(--color-brand);
    transform: translateY(-2px);
  }

  .group-card h3 {
    font-size: 1rem;
    margin: 0;
  }

  .cta-band {
    text-align: center;
    background: var(--color-navy-950);
    color: var(--color-white);
    border-radius: var(--radius-lg);
    padding-inline: var(--space-3);
  }

  .cta-band h2 {
    color: var(--color-white);
  }

  .cta-band p {
    color: var(--color-gray-300);
    margin-bottom: var(--space-3);
  }

  .cta-band .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
  }

  .cta-band .btn-outline {
    color: var(--color-white);
  }

  @media (max-width: 780px) {
    .three-col {
      grid-template-columns: 1fr;
    }
  }
</style>

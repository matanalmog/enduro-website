---
// גלריית "מהשטח" — תמונות אמיתיות מהמרוצים, האימונים והקבוצות של ENDURO (19.10.2026).
// התמונות עברו הקטנה והסרת מטא-דאטה (כולל מיקום GPS) לפני שנכנסו ל-public/images/gallery/.
import BaseLayout from "../layouts/BaseLayout.astro";
import gallery from "../data/gallery.json";

const sections = [
  { key: "races", title: "מרוצים וקווי סיום", alt: "רצי ENDURO במרוץ ובקו הסיום" },
  { key: "podium", title: "על הפודיום", alt: "מתאמני ENDURO על פודיום המנצחים" },
  { key: "trail", title: "שטח, מדבר והרים", alt: "ריצת שטח של ENDURO בהרים ובמדבר" },
  { key: "group", title: "אימוני קבוצה", alt: "אימון קבוצתי של ENDURO" },
  { key: "kids", title: "ילדים ונוער", alt: "אימון אתלטיקה לילדים של ENDURO" },
] as const;
---

<BaseLayout
  title="מהשטח: תמונות מהמרוצים והאימונים"
  description="תמונות מהמרוצים, מהאימונים ומהקבוצות של ENDURO: קווי סיום, פודיומים, ריצות שטח, אימוני קבוצה ואתלטיקה לילדים."
  canonicalPath="/gallery/"
>
  <section class="hero">
    <div class="container hero-inner">
      <h1>מהשטח</h1>
      <p class="lead">
        מרוצים, אימונים ורגעים מהדרך. בלי תמונות סטוק: אלה המתאמנים שלנו, בשטח.
      </p>
    </div>
  </section>

  {sections.map((s) => (
    <section class="container section gallery-section" id={s.key}>
      <h2>{s.title}</h2>
      <div class="gallery-grid">
        {gallery[s.key].map((img, i) => (
          <a href={img.src} class="gallery-item" target="_blank" rel="noopener">
            <img src={img.src} alt={`${s.alt} ${i + 1}`} width={img.w} height={img.h} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="container section cta-band">
    <h2>רוצים להיות בתמונה הבאה?</h2>
    <p>השאירו פרטים ונמצא יחד את הקבוצה או התוכנית שמתאימה לכם.</p>
    <div class="cta-actions">
      <a href="/free-plan/" class="btn btn-primary">השאירו פרטים</a>
      <a href="https://wa.me/972526982993" class="btn btn-outline" target="_blank" rel="noopener noreferrer">שלחו וואטסאפ</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-navy-950), var(--color-navy-900));
    color: var(--color-white);
  }
  .hero-inner {
    padding-block: var(--space-6) var(--space-5);
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }
  .hero h1 {
    color: var(--color-white);
  }
  .gallery-section h2 {
    margin-bottom: var(--space-3);
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-1);
  }
  @media (min-width: 640px) {
    .gallery-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1000px) {
    .gallery-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .gallery-item {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 6px;
    background: var(--color-gray-100);
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .gallery-item:hover img,
  .gallery-item:focus-visible img {
    transform: scale(1.04);
  }
  .cta-band {
    text-align: center;
  }
  .cta-actions {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }
</style>

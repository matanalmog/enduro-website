<script>
  const popEls = document.querySelectorAll(".pop-in");
  if ("IntersectionObserver" in window && popEls.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.2 }
    );
    popEls.forEach((el) => observer.observe(el));
  } else {
    popEls.forEach((el) => el.classList.add("is-visible"));
  }

  const statStrip = document.querySelector(".stat-strip");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (statStrip && "IntersectionObserver" in window && !prefersReducedMotion) {
    const digits = "0123456789";
    function scrambleStat(el, delay) {
      const finalText = el.textContent ?? "";
      const chars = finalText.split("");
      const duration = 550;
      const step = 35;
      let elapsed = 0;
      setTimeout(() => {
        const timer = setInterval(() => {
          elapsed += step;
          const lockedCount = Math.floor((elapsed / duration) * chars.length);
          el.textContent = chars
            .map((c, i) => {
              if (!/[0-9]/.test(c)) return c;
              return i < lockedCount ? c : digits[(Math.random() * 10) | 0];
            })
            .join("");
          if (elapsed >= duration) {
            clearInterval(timer);
            el.textContent = finalText;
          }
        }, step);
      }, delay);
    }

    const statObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.querySelectorAll(".num").forEach((el, i) => scrambleStat(el, i * 90));
            statObserver.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 }
    );
    statObserver.observe(statStrip);
  }
</script>

---
// דף הבית — עיצוב מחדש מלא (2026-09-20) לפי בריף מפורט של תומר: מיצוב מותג ENDURO
// חד וברור סביב אימון ריצה אישי, במקום הצגת כל שירותי האתר על אותו עמוד.
// מבנה: Hero -> מי ENDURO -> יעדי מרחק -> איך זה עובד -> מה מקבלים -> מי אני -> גמישות ->
// מסלולים ומחירים -> עדויות -> FAQ -> CTA סוגר.
import BaseLayout from "../layouts/BaseLayout.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import FaqItem from "../components/FaqItem.astro";
import { trainingPlans } from "../data/training-plans";

const beginnersPlan = trainingPlans.find((p) => p.slug === "beginners")!;
const halfMarathonPlan = trainingPlans.find((p) => p.slug === "half-marathon")!;
const marathonPlan = trainingPlans.find((p) => p.slug === "marathon")!;
const ultraMarathonPlan = trainingPlans.find((p) => p.slug === "ultra-marathon")!;

const distanceGoals = [
  {
    label: "מתחילים ו-10K",
    text: "בונים בסיס נכון, מתקדמים בהדרגה ומגיעים ל-10 ק\"מ בביטחון.",
  },
  {
    label: "חצי מרתון",
    text: "מתכוננים ל-21.1 ק\"מ בצורה מסודרת — עם בניית נפח, איכות והתאוששות.",
  },
  {
    label: "מרתון",
    text: "תהליך מלא לקראת 42.2 ק\"מ, מהבסיס ועד ליום המרוץ.",
  },
  {
    label: "אולטרה",
    text: "מרחקים ארוכים דורשים גישה אחרת. נפח, סבולת, קצב, תזונה וניהול עומס — הכל מתחבר לתמונה אחת.",
  },
];

const howItWorks = [
  {
    title: "מכירים אותך",
    text: "מתחילים בשאלון ובשיחה אישית. אני רוצה להבין מי אתה כרץ — הניסיון שלך, המטרה, שגרת החיים, הזמן שעומד לרשותך והאתגרים שצריך לקחת בחשבון.",
  },
  {
    title: "בונים את התוכנית",
    text: "התוכנית נבנית סביב החיים שלך ולא להפך. הימים, המרחקים, העצימות וסוגי האימונים מותאמים למטרה ולרמה שלך.",
  },
  {
    title: "מתאמנים",
    text: "האימונים נמצאים באפליקציה, עם הנחיות ברורות לכל אימון. אתה יודע מה לעשות, למה אתה עושה את זה ומה המטרה של האימון.",
  },
  {
    title: "עוקבים ומתאימים",
    text: "אני עובר על האימונים שביצעת ובוחן את ההתקדמות. התגובה שלך לאימונים משפיעה על מה שנעשה בהמשך.",
  },
  {
    title: "מתקדמים למטרה",
    text: "לא רצים רק כדי לסמן וי על אימון. בונים תהליך שמוביל אותך למטרה — בצורה חכמה, עקבית ובריאה ככל האפשר.",
  },
];

const included = [
  "תוכנית אימונים אישית",
  "התאמה למטרה ולרמת הרץ",
  "מעקב אחר ביצועי האימונים",
  "התאמות שוטפות לתוכנית",
  "הנחיות ברורות לכל אימון",
  "תרגילי כוח משלימים",
  "דגש על התאוששות וניהול עומסים",
  "ליווי אישי וזמינות לשאלות",
  "הכנה למרוצים ויעדים ספציפיים",
];

const homepagePlans = [
  {
    slug: beginnersPlan.slug,
    title: "10K / מתחילים",
    text: "למי שרוצה להתחיל לרוץ, לחזור לשגרה או להגיע ל-10 ק\"מ.",
    price: beginnersPlan.price,
  },
  {
    slug: halfMarathonPlan.slug,
    title: "חצי מרתון",
    text: "תהליך הכנה מסודר ל-21.1 ק\"מ ולשיפור ביצועים.",
    price: halfMarathonPlan.price,
  },
  {
    slug: marathonPlan.slug,
    title: "מרתון",
    text: "תוכנית מלאה לקראת 42.2 ק\"מ, כולל בניית עומס והכנה ליום המרוץ.",
    price: marathonPlan.price,
  },
  {
    slug: ultraMarathonPlan.slug,
    title: "אולטרה",
    text: "לרצים שרוצים לצאת מעבר למרתון ולהתמודד עם מרחקים ארוכים.",
    price: ultraMarathonPlan.price,
  },
];

const faqs = [
  {
    q: "האם האימון מתאים גם למתחילים?",
    a: "בהחלט. התוכנית נבנית בהתאם לנקודת הפתיחה שלך ולא בהתאם לרמה של רצים אחרים.",
  },
  {
    q: "האם חייבים להתאמן למרוץ?",
    a: "לא. אפשר לעבוד על שיפור הכושר, בניית בסיס, ירידה בזמני ריצה או פשוט להפוך את הריצה לחלק קבוע מהחיים.",
  },
  {
    q: "האם התוכנית משתנה במהלך הדרך?",
    a: "כן. התוכנית היא דינמית ומתעדכנת בהתאם לביצוע האימונים, להתקדמות ולמצב שלך.",
  },
  {
    q: "האם אפשר להתכונן למרוץ ספציפי?",
    a: "כן. אפשר לבנות את התהליך סביב מרוץ, תאריך ויעד מוגדרים.",
  },
  {
    q: "האם חייבים לרוץ בקבוצה?",
    a: "לא. האימון האישי מתקיים אונליין ומאפשר לך להתאמן במקום ובזמן שמתאימים לך.",
  },
  {
    q: "מה אם פספסתי אימון?",
    a: "לא צריך \"להשלים\" אוטומטית כל אימון שפספסת. בוחנים את השבוע כולו ומחליטים מה נכון לעשות הלאה.",
  },
  {
    q: "האם יש קשר ישיר עם המאמן?",
    a: "כן. הליווי כולל אפשרות להתייעץ ולשאול שאלות לאורך הדרך.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Enduro | sport4you.co.il",
    "image": "https://www.sport4you.co.il/images/logo.jpg",
    "description": "אימוני ריצה וכושר אישיים וקבוצתיים עם המאמן תומר אלמוג, רחוב הזית 6, רמת השרון.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "רחוב הזית 6",
      "addressLocality": "רמת השרון",
      "addressCountry": "IL",
    },
    "telephone": "+972-52-6982993",
    "email": "tomeral@gmail.com",
    "founder": {
      "@type": "Person",
      "name": "תומר אלמוג",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a,
      },
    })),
  },
];
---

<BaseLayout
  title="מאמן ריצה אונליין | תוכנית אימון ריצה אישית"
  description="תוכנית אימון ריצה אונליין אישית עם תומר אלמוג, מאמן ריצה וכושר מוסמך. ליווי מלא באפליקציה, ממתחילים ועד אולטרה מרתון. השאירו פרטים ונחזור אליכם."
  canonicalPath="/"
  schema={schema}
>
  <section class="hero">
    <svg class="hero-route" viewBox="0 0 1000 500" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <path class="hero-route-path" d="M -20 420 C 140 460, 240 300, 380 340 S 560 180, 680 210 S 880 100, 1020 130"
        stroke="var(--color-orange-500)" stroke-width="2.5" stroke-opacity="0.5" />
      <circle cx="680" cy="210" r="4" fill="var(--color-gold-500)" />
    </svg>
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="hero-eyebrow num">ENDURO</span>
        <h1>ריצה. אימון. דרך.</h1>
        <p class="hero-strong">תוכנית אימונים אישית שנבנית סביבך — ולא סביב תבנית מוכנה.</p>
        <p class="lead">
          בין אם המטרה שלך היא לרוץ 10 ק"מ בפעם הראשונה, לשבור שיא אישי
          במרתון או להתמודד עם האתגר הבא באולטרה — אני בונה איתך את הדרך,
          עוקב אחרי ההתקדמות ומתאים את האימונים למה שקורה בפועל.
        </p>
        <div class="hero-actions">
          <a href="/free-plan/" class="btn btn-primary">בדקו התאמה לאימון אישי</a>
          <a href="https://wa.me/972526982993" class="btn btn-outline" target="_blank" rel="noopener noreferrer">דברו איתי בוואטסאפ</a>
        </div>
      </div>
    </div>
    <a href="#why" class="hero-scroll" aria-label="גללו למטה">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </section>

  <section id="why" class="container section why-band">
    <h2>לא עוד תוכנית אימונים. מאמן שמכיר את הדרך שלך.</h2>
    <p>
      תוכנית טובה לא אמורה להישאר זהה מהרגע שקיבלת אותה. היא צריכה להשתנות
      כשאתה מתקדם, כשיש עומס בעבודה, כשפספסת אימון, כשאתה עייף, כשמשהו כואב
      או כשהגוף פשוט אומר שצריך לשנות כיוון.
    </p>
    <p>ב-ENDURO אני לא רק בונה את השבוע הבא. אני עוקב אחרי הדרך שאתה עושה ומתאים אותה אליך.</p>
    <p class="why-tagline">היעד שלך. הקצב שלך. הדרך שלך.</p>
  </section>

  <section class="container section section-muted">
    <h2>לאן אתה רוצה להגיע?</h2>
    <div class="goals-grid">
      {distanceGoals.map((g, i) => (
        <div class="goal-card pop-in" style={`--goal-i: ${i}`}>
          <span class="goal-dot" aria-hidden="true"></span>
          <h3>{g.label}</h3>
          <p>{g.text}</p>
        </div>
      ))}
    </div>
    <p class="goals-footer">לא משנה מאיפה אתה מתחיל. חשוב לדעת לאן אתה רוצה להגיע.</p>
  </section>

  <section class="container section">
    <h2>איך זה עובד?</h2>
    <div class="two-col how-grid">
      {howItWorks.map((step, i) => (
        <div class="feature-card included-card pop-in">
          <span class="included-index num">{String(i + 1).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container section section-muted">
    <h2>מה מקבלים ב-ENDURO?</h2>
    <ul class="included-checklist">
      {included.map((item) => <li>{item}</li>)}
    </ul>
    <p class="included-footer">והכי חשוב — יש בן אדם אמיתי מאחורי התוכנית.</p>
  </section>

  <section class="container section" id="about-me">
    <h2>מי אני</h2>
    <div class="about-grid">
      <img
        src="/images/action/tomer-portrait-sunglasses.jpg"
        alt="תומר אלמוג, מאמן ריצה וכושר"
        class="about-photo"
      />
      <div class="about-text">
        <p class="about-name">תומר אלמוג</p>
        <p>
          מאמן ריצה וכושר, מנטור ומלווה רצים מתחילים, תחרותיים ורצי מרחקים
          ארוכים. אני מאמין שאימון טוב צריך לחבר בין ביצועים לבין החיים
          עצמם. לא כל שבוע מושלם, לא כל אימון מצליח, ולא כל תוכנית צריכה
          להיראות אותו דבר.
        </p>
        <p>
          המטרה שלי היא לעזור לך להתקדם לאורך זמן — עם עבודה קשה כשצריך,
          גמישות כשצריך, ובעיקר עם תהליך שאפשר להתמיד בו.
        </p>
        <p class="about-runner-line">גם אני רץ את הדרך.</p>
        <div class="stat-strip">
          <div><span class="num">2:43</span><span>מרתון</span></div>
          <div><span class="num">1:17</span><span>חצי מרתון</span></div>
          <div><span class="num">34:12</span><span>10 ק"מ</span></div>
          <div><span class="num">#1</span><span>אולטרה 66 ק"מ</span></div>
        </div>
        <a href="/about-me/" class="about-more">עוד עליי, ההסמכות והניסיון &larr;</a>
      </div>
    </div>
  </section>

  <section class="container section section-muted life-band">
    <h2>אימון שמתאים לחיים שלך</h2>
    <p>יש לך עבודה. משפחה. חופשות. נסיעות. ימים עמוסים. ולפעמים פשוט אין כוח.</p>
    <p>לכן התוכנית שלך לא צריכה להיות מושלמת על הנייר. היא צריכה להיות <strong>אפשרית לביצוע במציאות</strong>.</p>
    <p class="life-tagline">כשצריך — משנים. כשאפשר — דוחפים. וכשצריך לעצור — יודעים גם לעצור.</p>
  </section>

  <section class="container section" id="pricing">
    <h2>המסלולים</h2>
    <div class="plans-grid">
      {homepagePlans.map((plan) => (
        <a href={`/training-plans/${plan.slug}/`} class="plan-card">
          <h3>{plan.title}</h3>
          <p>{plan.text}</p>
          <span class="price num">{plan.price} לחודש</span>
        </a>
      ))}
    </div>
    <p class="plans-footer">
      בכל המסלולים: <strong>תוכנית אישית | מעקב | התאמות | ליווי אישי</strong>
    </p>
    <div class="plans-cta">
      <a href="/free-plan/" class="btn btn-primary">אני רוצה להתחיל</a>
    </div>
  </section>

  <section class="container section section-muted">
    <h2>מה אומרים המתאמנים?</h2>
    <div class="testimonials-grid">
      <TestimonialCard
        image="/images/testimonials/mariana-mali.jpg"
        name="Mariana Mali"
        role="ריצת שטח"
        quote="תודה למאמן התותח שלי תומר אלמוג שבחודש מאי קיבל אותי פצועה בגוף ובנפש, ועם תנאים בלתי אפשריים שהצבתי לו מדי שבוע, לימד אותי לעוף על השטח, לאהוב עליות, ובעיקר להנות מהדרך. תודה תומר, שלימדת אותי מהי חדות ריצה אמיתית."
      />
      <TestimonialCard
        name="ערן טל"
        quote="תודה רבה על 8 החודשים האחרונים. אתה והסגנון אימון שלך זה בדיוק מה שהייתי צריך: מקצועיות שנובעת משנים של ניסיון, עבודה מסודרת, בלי שטויות ובלגן. תודה שעזרת לי לכבוש את הפסגה הזאת."
      />
      <TestimonialCard
        image="/images/testimonials/oshr-zelig.jpg"
        name="אושר זליג"
        role="חצי מרתון"
        quote="3 חודשים של אימון אונליין הספיקו לי כדי לנפץ את שיאי בחצי מרתון לאחר 3 שנים של ניסיונות. תומר מסור עד הרגע האחרון."
      />
      <TestimonialCard
        image="/images/testimonials/udi-birkan.jpg"
        name="אודי בירקאן"
        role="מנכ״ל GPS"
        quote="תומר מנחה אותי ומכוון אותי ברגישות והבנה מקצועית, מייעץ לי לתזונה נכונה ואימונים משלימים, וזו הפעם הראשונה יותר משנה וחצי בלי פציעות."
      />
      <TestimonialCard
        name="אורנה אלעד"
        quote="תומר מקצועי ומקסים, מומלץ בחום! גם אימן את אבא שלי בן 80 וגם אותי."
      />
      <TestimonialCard
        name="איתן יאיר"
        role="ירידה של 10 ק״ג"
        quote="10 קילו זה מה שירדתי תוך כמה חודשים בעזרת תומר, והיד עוד נטויה. המון אימוני כושר, ריצות, תרגילים, אבל הסיבה העיקרית: תומר היה מסור לאימונים, עבד ועקב אחריי כאילו אני זה הוא."
      />
      <TestimonialCard
        name="אלרום"
        quote="תומר, רוצה להגיד לך באופן אישי תודה ענקית. בזכותך הגשמתי חלום ועמדתי ביעד. נהניתי מהדרך איתך, מהמירוץ עצמו בטירוף למרות הקשיים."
      />
    </div>
  </section>

  <section class="container section" id="faq">
    <h2>שאלות נפוצות</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <FaqItem question={f.q}>
          <p>{f.a}</p>
        </FaqItem>
      ))}
    </div>
  </section>

  <section class="container section cta-band">
    <h2>לא מחפשים תוכנית. מחפשים דרך.</h2>
    <p>אם יש לך מטרה ברורה — או רק תחושה שהגיע הזמן להתחיל — בוא נדבר. ספר לי איפה אתה נמצא היום ולאן אתה רוצה להגיע.</p>
    <div class="cta-actions">
      <a href="/free-plan/" class="btn btn-primary">בדקו התאמה לאימון אישי</a>
      <a href="https://wa.me/972526982993" class="btn btn-outline" target="_blank" rel="noopener noreferrer">דברו איתי בוואטסאפ</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-navy-950);
    color: var(--color-white);
  }

  .hero-route {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
  }

  .hero-route-path {
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    animation: hero-route-draw 3.5s ease-out forwards;
  }

  @keyframes hero-route-draw {

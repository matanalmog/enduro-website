---
// דף הבית — גרסה 2 (2026-09-20), לפי wireframe מפורט: Hero פיצול תמונה/טקסט חד וקצר,
// פס אמון, סקציית "בעיה שהלקוח מכיר", תהליך עבודה, "למי זה מתאים" (כרטיסים מקושרים),
// "מי אני" אישי, "מה באמת מקבלים" מינימלי, 3 עדויות מצומצמות, מחירון כרטיסי-צ'ק,
// FAQ מצומצם, CTA כהה דרמטי, וסרגל צף במובייל (WhatsApp + בדיקת התאמה).
import BaseLayout from "../layouts/BaseLayout.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import FaqItem from "../components/FaqItem.astro";
import { trainingPlans } from "../data/training-plans";

const beginnersPlan = trainingPlans.find((p) => p.slug === "beginners")!;
const halfMarathonPlan = trainingPlans.find((p) => p.slug === "half-marathon")!;
const marathonPlan = trainingPlans.find((p) => p.slug === "marathon")!;
const ultraMarathonPlan = trainingPlans.find((p) => p.slug === "ultra-marathon")!;

const audienceCards = [
  { slug: beginnersPlan.slug, title: "מתחילים", text: "מאפס → 10K" },
  { slug: halfMarathonPlan.slug, title: "חצי מרתון", text: "21.1 ק\"מ" },
  { slug: marathonPlan.slug, title: "מרתון", text: "42.2 ק\"מ" },
  { slug: ultraMarathonPlan.slug, title: "אולטרה", text: "מעבר למרתון" },
];

const howItWorks = [
  { title: "מכירים", text: "שאלון + שיחה אישית." },
  { title: "מתכננים", text: "בונים את השבוע בהתאם למטרה ולחיים שלך." },
  { title: "מתאמנים", text: "האימונים מגיעים ישירות לאפליקציה." },
  { title: "עוקבים", text: "אני עובר על האימונים וההתקדמות שלך." },
  { title: "מתאימים", text: "התוכנית משתנה בהתאם למה שקורה." },
];

const included = [
  { title: "התאמה אישית", text: "התוכנית נבנית סביב המטרה והמציאות שלך." },
  { title: "מעקב", text: "האימונים שביצעת הם חלק מקבלת ההחלטות." },
  { title: "כוח", text: "תרגילים משלימים כדי לתמוך בריצה." },
  { title: "התאוששות", text: "ניהול עומסים הוא חלק מהאימון." },
  { title: "קשר אישי", text: "יש לך מאמן שאפשר לדבר איתו." },
  { title: "הכנה למרוץ", text: "הדרך מתוכננת עד לקו הזינוק." },
];

const homepagePlans = [
  { slug: beginnersPlan.slug, title: "10K / מתחילים", price: beginnersPlan.price },
  { slug: halfMarathonPlan.slug, title: "חצי מרתון", price: halfMarathonPlan.price },
  { slug: marathonPlan.slug, title: "מרתון", price: marathonPlan.price },
  { slug: ultraMarathonPlan.slug, title: "אולטרה", price: ultraMarathonPlan.price },
];

const faqs = [
  {
    q: "האם האימון מתאים גם למתחילים?",
    a: "בהחלט. התוכנית נבנית בהתאם לנקודת הפתיחה שלך ולא בהתאם לרמה של רצים אחרים.",
  },
  {
    q: "האם חייבים להתאמן למרוץ?",
    a: "לא. אפשר לעבוד על שיפור הכושר, בניית בסיס, ירידה בזמני ריצה או פשוט להפוך את הריצה לחלק קבוע מהחיים.",
  },
  {
    q: "האם התוכנית משתנה במהלך הדרך?",
    a: "כן. התוכנית היא דינמית ומתעדכנת בהתאם לביצוע האימונים, להתקדמות ולמצב שלך.",
  },
  {
    q: "האם אפשר להתכונן למרוץ ספציפי?",
    a: "כן. אפשר לבנות את התהליך סביב מרוץ, תאריך ויעד מוגדרים.",
  },
  {
    q: "האם חייבים לרוץ בקבוצה?",
    a: "לא. האימון האישי מתקיים אונליין ומאפשר לך להתאמן במקום ובזמן שמתאימים לך.",
  },
  {
    q: "מה אם פספסתי אימון?",
    a: "לא צריך \"להשלים\" אוטומטית כל אימון שפספסת. בוחנים את השבוע כולו ומחליטים מה נכון לעשות הלאה.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Enduro | sport4you.co.il",
    "image": "https://www.sport4you.co.il/images/logo.jpg",
    "description": "אימוני ריצה וכושר אישיים וקבוצתיים עם המאמן תומר אלמוג, רחוב הזית 6, רמת השרון.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "רחוב הזית 6",
      "addressLocality": "רמת השרון",
      "addressCountry": "IL",
    },
    "telephone": "+972-52-6982993",
    "email": "tomeral@gmail.com",
    "founder": {
      "@type": "Person",
      "name": "תומר אלמוג",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a,
      },
    })),
  },
];
---

<BaseLayout
  title="מאמן ריצה אונליין | תוכנית אימון ריצה אישית"
  description="תוכנית אימון ריצה אונליין אישית עם תומר אלמוג, מאמן ריצה וכושר מוסמך. ליווי מלא באפליקציה, ממתחילים ועד אולטרה מרתון. השאירו פרטים ונחזור אליכם."
  canonicalPath="/"
  schema={schema}
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-photo">
        <img
          src="/images/action/tomer-elite-race-pack.jpg"
          alt="תומר אלמוג רץ בקבוצה מובילה במרוץ תחרותי"
          width="700"
          height="875"
        />
      </div>
      <div class="hero-text">
        <span class="hero-eyebrow num">ENDURO</span>
        <h1>התמדה. נחישות.<br />קהילה.</h1>
        <p class="hero-strong">תוכנית אימונים אישית שנבנית סביבך — ולא סביב תבנית מוכנה.</p>
        <p class="lead">למתחילים, לרצים תחרותיים ולרצי מרחקים ארוכים.</p>
        <div class="hero-actions">
          <a href="/free-plan/" class="btn btn-primary">בדקו התאמה לאימון אישי &larr;</a>
        </div>
        <p class="hero-distances">10K &middot; חצי מרתון &middot; מרתון &middot; אולטרה</p>
      </div>
    </div>
  </section>

  <div class="container trust-strip">
    <span>250+ רצים</span>
    <span class="dot" aria-hidden="true">&middot;</span>
    <span>מתחילים ועד אולטרה</span>
    <span class="dot" aria-hidden="true">&middot;</span>
    <span>ישראל + חו"ל</span>
    <span class="dot" aria-hidden="true">&middot;</span>
    <span>ליווי אישי</span>
  </div>

  <section class="container section problem-band">
    <h2>אתה לא צריך עוד תוכנית מהאינטרנט.</h2>
    <p class="problem-lead">יש לך כבר תוכנית. אבל מה קורה כש:</p>
    <ul class="problem-list">
      <li>העבודה מתארכת?</li>
      <li>פספסת אימון?</li>
      <li>הקצב לא מסתדר?</li>
      <li>העומס עולה?</li>
      <li>יש כאב?</li>
      <li>הכושר משתפר?</li>
    </ul>
    <p class="problem-turn">התוכנית צריכה להשתנות איתך.</p>
    <p class="problem-resolve">ב-ENDURO האימונים נבנים, נבדקים ומתעדכנים בהתאם למה שקורה בפועל.</p>
  </section>

  <section class="container section section-muted">
    <h2>איך זה עובד?</h2>
    <div class="how-grid">
      {howItWorks.map((step, i) => (
        <div class="feature-card included-card pop-in">
          <span class="included-index num">{String(i + 1).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container section">
    <h2>למי זה מתאים?</h2>
    <div class="audience-grid">
      {audienceCards.map((a) => (
        <a href={`/training-plans/${a.slug}/`} class="audience-card pop-in">
          <h3>{a.title}</h3>
          <p class="num">{a.text}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="container section section-muted" id="about-me">
    <div class="about-grid">
      <img
        src="/images/action/tomer-portrait-sunglasses.jpg"
        alt="תומר אלמוג, מאמן ריצה וכושר"
        class="about-photo"
      />
      <div class="about-text">
        <p class="about-belief">אני מאמין בריצה לטווח ארוך. לא רק בתוצאה של המרוץ הבא.</p>
        <p>
          תומר אלמוג, מאמן ריצה וכושר, מלווה רצים מתחילים, תחרותיים ורצי
          מרחקים ארוכים. אני לא רק מאמן מהצד — אני רץ בעצמי, ומכיר את הדרך
          מבפנים.
        </p>
        <p class="stats-label">המספרים שלי</p>
        <div class="stat-strip">
          <div><span class="num">2:43</span><span>מרתון</span></div>
          <div><span class="num">1:17</span><span>חצי מרתון</span></div>
          <div><span class="num">34:12</span><span>10K</span></div>
          <div><span class="num">66 KM</span><span>אולטרה</span></div>
        </div>
        <a href="/about-me/" class="about-more">קצת יותר עליי &larr;</a>
      </div>
    </div>
  </section>

  <section class="container section">
    <h2>מה באמת מקבלים</h2>
    <div class="included-grid">
      {included.map((item) => (
        <div class="included-item pop-in">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container section section-muted">
    <h2>רצים שמתקדמים</h2>
    <div class="results-grid">
      <TestimonialCard
        image="/images/testimonials/oshr-zelig.jpg"
        name="אושר זליג"
        role="חצי מרתון"
        quote="3 חודשים של אימון אונליין הספיקו לי כדי לנפץ את שיאי בחצי מרתון לאחר 3 שנים של ניסיונות. תומר מסור עד הרגע האחרון."
      />
      <TestimonialCard
        name="איתן יאיר"
        role="ירידה של 10 ק״ג"
        quote="המון אימוני כושר, ריצות, תרגילים, אבל הסיבה העיקרית: תומר היה מסור לאימונים, עבד ועקב אחריי כאילו אני זה הוא."
      />
      <TestimonialCard
        image="/images/testimonials/udi-birkan.jpg"
        name="אודי בירקאן"
        role="בלי פציעות משנה וחצי"
        quote="תומר מנחה אותי ומכוון אותי ברגישות והבנה מקצועית, וזו הפעם הראשונה יותר משנה וחצי בלי פציעות."
      />
    </div>
    <div class="results-footer">
      <a href="/about-me/#testimonials" class="results-link">לכל הסיפורים &larr;</a>
    </div>
  </section>

  <section class="container section" id="pricing">
    <h2>בוחרים את המסלול שמתאים למטרה שלך</h2>
    <div class="plans-grid">
      {homepagePlans.map((plan) => (
        <a href={`/training-plans/${plan.slug}/`} class="plan-card">
          <h3>{plan.title}</h3>
          <span class="price num">{plan.price} / חודש</span>
        </a>
      ))}
    </div>
    <div class="plans-included">
      <p class="plans-included-label">כל המסלולים כוללים:</p>
      <ul class="plans-checklist">
        <li>תוכנית אישית</li>
        <li>מעקב</li>
        <li>התאמות</li>
        <li>ליווי אישי</li>
        <li>אפליקציה</li>
      </ul>
    </div>
    <div class="plans-cta">
      <a href="/free-plan/" class="btn btn-primary">בדקו איזה מסלול מתאים לכם &larr;</a>
    </div>
  </section>

  <section class="container section" id="faq">
    <h2>שאלות נפוצות</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <FaqItem question={f.q}>
          <p>{f.a}</p>
        </FaqItem>
      ))}
    </div>
  </section>

  <section class="container section cta-band">
    <h2>הגיע הזמן לצאת לדרך.</h2>
    <p>ספר לי לאן אתה רוצה להגיע. אני אעזור לך לבנות את הדרך לשם.</p>
    <div class="cta-actions">
      <a href="/free-plan/" class="btn btn-primary">בדקו התאמה לאימון אישי &larr;</a>
      <a href="https://wa.me/972526982993" class="btn btn-outline" target="_blank" rel="noopener noreferrer">או דברו איתי בוואטסאפ</a>
    </div>
  </section>

  <div class="mobile-bar" aria-label="פעולות מהירות">
    <a href="https://wa.me/972526982993" target="_blank" rel="noopener noreferrer" class="mobile-bar-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m0 1.67c2.24 0 4.35.87 5.94 2.46a8.3 8.3 0 0 1 2.45 5.92c0 4.61-3.75 8.36-8.36 8.36a8.36 8.36 0 0 1-4.25-1.16l-.3-.18-3.12.82.83-3.04-.2-.31a8.3 8.3 0 0 1-1.28-4.45c0-4.61 3.76-8.37 8.29-8.37m-4.58 4.6c-.16 0-.42.06-.65.31-.22.24-.85.83-.85 2.02 0 1.19.87 2.34.99 2.5.12.16 1.7 2.72 4.2 3.71 2.08.83 2.5.66 2.95.62.45-.04 1.46-.6 1.66-1.18.2-.58.2-1.07.14-1.18-.06-.1-.22-.16-.46-.28-.24-.12-1.46-.72-1.68-.8-.23-.08-.4-.12-.56.12-.16.24-.64.8-.78.97-.14.16-.29.18-.53.06-.24-.12-1.03-.38-1.96-1.2-.72-.65-1.21-1.44-1.35-1.68-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.42h-.47Z"/></svg>
      וואטסאפ
    </a>
    <a href="/free-plan/" class="mobile-bar-btn mobile-bar-btn-primary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M13 5l7 7-7 7M5 12h15" stroke-linecap="round" stroke-linejoin="round"/></svg>
      בדיקת התאמה
    </a>
  </div>
</BaseLayout>

<style>
  .hero {
    background: var(--color-navy-950);
    color: var(--color-white);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-5);
    min-height: 70vh;
  }

  .hero-photo {
    order: 2;
  }

  .hero-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  [dir="rtl"] .hero-photo {
    order: 2;
  }

  .hero-text {
    order: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
    text-align: right;
  }

  .hero-eyebrow {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    color: var(--color-gold-500);
  }

  .hero h1 {
    color: var(--color-white);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.1;
    text-wrap: balance;
    margin: 0;
  }

  .hero-strong {
    color: var(--color-white);
    font-weight: 700;
    font-size: 1.2rem;
    max-width: 32ch;
    text-wrap: balance;
    margin: 0;
  }

  .hero .lead {
    color: var(--color-gray-300);
    font-size: 1.05rem;
    margin: 0;
  }

  .hero-actions {
    margin-top: var(--space-2);
  }

  .hero-distances {
    margin-top: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-gray-300);
    letter-spacing: 0.02em;
  }

  @media (max-width: 780px) {
    .hero-inner {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-block: var(--space-4);
    }

    .hero-photo {
      order: 1;
      max-width: 320px;
      margin-inline: auto;
    }

    .hero-text {
      order: 2;
      align-items: center;
      text-align: center;
    }

    .hero-strong {
      max-width: none;
    }

    .hero-actions .btn {
      width: 100%;
    }
  }

  .trust-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
    background: var(--color-gray-50);
    border-bottom: 1px solid var(--color-gray-100);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .trust-strip .dot {
    color: var(--color-gray-300);
  }

  .pop-in {
    opacity: 0;
    transform: scale(0.92) translateY(16px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .pop-in.is-visible {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  .section {
    padding-block: var(--space-5);
  }

  .section-muted {
    background: var(--color-gray-50);
  }

  .section h2 {
    margin-bottom: var(--space-3);
  }

  .problem-band {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }

  .problem-lead {
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .problem-list {
    list-style: none;
    margin: var(--space-2) 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .problem-list li {
    background: var(--color-gray-50);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .problem-turn {
    margin-top: var(--space-3);
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--color-navy-950);
  }

  .problem-resolve {
    color: var(--color-text-muted);
  }

  .how-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-3);
  }

  .feature-card {
    background: var(--color-white);
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-md);
    padding: var(--space-3);
  }


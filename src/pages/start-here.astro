---
// "חיבור אפליקציות": מדריך הצטרפות למתאמן חדש. מקושר מתפריט אודות ומסך הסיום של שאלון הקליטה.
// בלוק לכל נושא (חיבור האפליקציה, Garmin, Apple, Strava, אחרים), ולכל נושא ריבוע לסרטון יוטיוב.
// התוכן נשלט מ-src/data/onboarding.ts. הדף לא מיועד לחיפוש (noindex).
import BaseLayout from "../layouts/BaseLayout.astro";
import YouTubeEmbed from "../components/YouTubeEmbed.astro";
import OnboardingStep from "../components/OnboardingStep.astro";
import { onboardingSteps, onboardingTopics } from "../data/onboarding";

const stepById = new Map(onboardingSteps.map((s) => [s.id, s]));
const topics = onboardingTopics
  .map((t) => ({
    ...t,
    stepList: t.steps.map((id) => stepById.get(id)).filter((s) => s && s.ready),
    windowList: (t.windows ?? [])
      .map((w) => ({ label: w.label, step: stepById.get(w.stepId) }))
      .filter((w) => w.step && w.step.ready),
  }))
  .filter((t) => t.stepList.length > 0);
---

<BaseLayout
  title="חיבור אפליקציות"
  description="מדריך הצטרפות למתאמנים של ENDURO: הרשמה ל-Final Surge, חיבור Garmin, Apple ו-Strava."
  canonicalPath="/start-here/"
  noindex
>
  <section class="container section guide">
    <h1>חיבור אפליקציות</h1>
    <p class="lead">
      כאן מרוכז מה שצריך כדי להתחיל להתאמן איתי. בוחרים נושא, ובכל נושא יש הסבר בשלבים ותמונות, וסרטון הדרכה.
    </p>

    <div class="layout">
      <div class="blocks" role="tablist" aria-label="נושאי המדריך">
        {
          topics.map((t, i) => (
            <button
              type="button"
              class="block"
              data-topic={t.id}
              aria-controls={`panel-${t.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              role="tab"
            >
              <span class="block-icon" aria-hidden="true">{t.icon}</span>
              <span class="block-label">{t.label}</span>
            </button>
          ))
        }
      </div>

      <div class="panels">
        {
          topics.map((t, i) => (
            <section class="panel" id={`panel-${t.id}`} role="tabpanel" hidden={i !== 0}>
              <div class="panel-head">
                <div class="panel-text">
                  <h2>{t.label}</h2>
                  <p>{t.summary}</p>
                </div>
                <div class="panel-video">
                  {t.video.youtubeId ? (
                    <YouTubeEmbed videoId={t.video.youtubeId} title={t.video.title} />
                  ) : t.video.src ? (
                    <video class="local-video" controls preload="metadata" playsinline aria-label={t.video.title}>
                      <source src={t.video.src} type="video/mp4" />
                    </video>
                  ) : (
                    <div class="video-slot" role="img" aria-label={`${t.video.title}: הסרטון יעלה בקרוב`}>
                      <svg viewBox="0 0 68 48" width="64" height="46" aria-hidden="true">
                        <path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.41 6.19C.13 13.05 0 24 0 24s.13 10.95 1.49 16.26c.78 2.93 2.48 5.41 5.41 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.87 34.95 68 24 68 24s-.13-10.95-1.48-16.26z" fill="#6b7280" />
                        <path d="M45 24 27 14v20" fill="#fff" />
                      </svg>
                      <span class="video-slot-title">{t.video.title}</span>
                      <span class="video-slot-soon">סרטון הדרכה בקרוב</span>
                    </div>
                  )}
                </div>
              </div>

              <p class="official">
                <span aria-hidden="true">📖</span>
                <a href={t.official.href} target="_blank" rel="noopener">{t.official.label}</a>
              </p>

              <ol class="steps">
                {
                  t.stepList.map((step, n) => (
                    <li>
                      <OnboardingStep step={step!} number={t.stepList.length > 1 ? n + 1 : undefined} />
                    </li>
                  ))
                }
              </ol>

              {
                t.windowList.map((w) => (
                  <details class="window" id={`window-${w.step!.id}`}>
                    <summary>
                      <span class="window-icon" aria-hidden="true">🔓</span>
                      <span class="window-label">{w.label}</span>
                      <span class="window-hint">לחץ לפתיחה</span>
                    </summary>
                    <div class="window-body">
                      <OnboardingStep step={w.step!} />
                    </div>
                  </details>
                ))
              }
            </section>
          ))
        }
      </div>
    </div>

    <noscript>
      <p>להחלפת נושאים נדרש JavaScript. בלעדיו מוצג רק הנושא הראשון, וכל השאר זמינים בוואטסאפ.</p>
    </noscript>

    <p class="help">
      צריך עזרה? <a href="https://wa.me/972526982993" rel="noopener">וואטסאפ 052-6982993</a>
    </p>
  </section>
</BaseLayout>

<script>
  // החלפת נושא בלי טעינת דף. תומך בקישור ישיר (#garmin) ובשמירת הבחירה בכתובת.
  const blocks = Array.from(document.querySelectorAll<HTMLButtonElement>(".block"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>(".panel"));

  function show(id: string, updateHash: boolean) {
    const target = panels.find((p) => p.id === `panel-${id}`);
    if (!target) return;
    panels.forEach((p) => {
      p.hidden = p !== target;
    });
    blocks.forEach((b) => b.setAttribute("aria-selected", String(b.dataset.topic === id)));
    if (updateHash) history.replaceState(null, "", `#${id}`);
  }

  blocks.forEach((b) => b.addEventListener("click", () => show(b.dataset.topic!, true)));

  const initial = location.hash.replace("#", "");
  if (initial) {
    // קישור לשלב בתוך נושא (למשל #sync) פותח את הנושא שמכיל אותו
    const stepEl = document.getElementById(initial);
    const panel = stepEl?.closest<HTMLElement>(".panel");
    if (panel) {
      show(panel.id.replace("panel-", ""), false);
      // שלב שנמצא בחלון נפתח (למשל #garmin) פותח את החלון
      const win = stepEl?.closest<HTMLDetailsElement>("details.window");
      if (win) win.open = true;
      stepEl?.scrollIntoView();
    } else {
      show(initial, false);
    }
  }
</script>

<style>
  .guide {
    max-width: 1100px;
  }
  .lead {
    color: var(--color-text-muted);
  }
  .layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: var(--space-4, 1.5rem);
    margin-top: var(--space-4, 1.5rem);
    align-items: start;
  }
  .blocks {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: sticky;
    top: 5.5rem;
  }
  .block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.35rem;
    min-height: 92px;
    padding: 0.9rem 1rem;
    border: 2px solid var(--color-border, #e4e7ec);
    border-radius: 16px;
    background: var(--color-surface, #fff);
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .block:hover {
    border-color: #b34700;
  }
  .block:focus-visible {
    outline: 3px solid #b34700;
    outline-offset: 2px;
  }
  .block[aria-selected="true"] {
    border-color: #b34700;
    box-shadow: 0 0 0 3px rgba(179, 71, 0, 0.15);
  }
  .block-icon {
    font-size: 1.7rem;
    line-height: 1;
  }
  .block-label {
    font-weight: 700;
  }

  .panel-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-4, 1.5rem);
    align-items: center;
    margin-bottom: var(--space-4, 1.5rem);
  }
  .panel-text h2 {
    margin: 0 0 0.35rem;
  }
  .panel-text p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .video-slot {
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    border: 2px dashed #9ca3af;
    background: #f3f4f6;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    text-align: center;
    padding: 0.75rem;
    color: #374151;
  }
  .video-slot-title {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .video-slot-soon {
    font-size: 0.85rem;
    color: #4b5563;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1.5rem);
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1.5rem);
  }
  .official {
    margin: 0 0 var(--space-3, 1rem);
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border, #e4e7ec);
    border-inline-start: 4px solid #b34700;
    border-radius: 10px;
    background: var(--color-surface, #fff);
  }
  .local-video {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    background: #000;
  }
  .window {
    margin-top: var(--space-4, 1.5rem);
    border: 2px solid #b34700;
    border-radius: 16px;
    background: var(--color-surface, #fff);
  }
  .window > summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    font-weight: 700;
  }
  .window > summary::-webkit-details-marker {
    display: none;
  }
  .window > summary:focus-visible {
    outline: 3px solid #b34700;
    outline-offset: 2px;
    border-radius: 14px;
  }
  .window-icon {
    font-size: 1.5rem;
  }
  .window-label {
    flex: 1;
    font-size: 1.1rem;
  }
  .window-hint {
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .window[open] .window-hint {
    display: none;
  }
  .window-body {
    padding: 0 1.25rem 1.25rem;
  }
  .help {
    margin-top: var(--space-4, 1.5rem);
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .blocks {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .block {
      min-height: 84px;
    }
    .panel-head {
      grid-template-columns: 1fr;
    }
  }
</style>

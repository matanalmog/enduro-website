          <input type="number" id="ag-time-h" min="0" max="9" placeholder="שע" inputmode="numeric" aria-label="שעות" />
          <span aria-hidden="true">:</span>
          <input type="number" id="ag-time-m" min="0" max="59" placeholder="דק" inputmode="numeric" aria-label="דקות" />
          <span aria-hidden="true">:</span>
          <input type="number" id="ag-time-s" min="0" max="59" placeholder="שנ" inputmode="numeric" aria-label="שניות" />
        </div>
      </div>

      <button type="button" id="ag-submit" class="btn btn-primary">חשבו דירוג</button>


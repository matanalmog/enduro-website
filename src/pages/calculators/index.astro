  // ---------- מנבא תוצאות (Riegel) ----------
  (function predictor() {
    const distanceSelect = document.getElementById("pred-distance") as HTMLSelectElement | null;
    const timeH = document.getElementById("pred-time-h") as HTMLInputElement | null;
    const timeM = document.getElementById("pred-time-m") as HTMLInputElement | null;
    const timeS = document.getElementById("pred-time-s") as HTMLInputElement | null;
    const submitBtn = document.getElementById("pred-submit");
    const errorEl = document.getElementById("pred-error");
    const resultsEl = document.getElementById("pred-results");
    const splitsBody = document.getElementById("pred-splits-body");

    const DISTANCES: { km: number; label: string }[] = [
      { km: 5, label: '5 ק"מ' },
      { km: 10, label: '10 ק"מ' },
      { km: 21.0975, label: "חצי מרתון" },
      { km: 42.195, label: "מרתון מלא" },
    ];

    function showError(message: string) {
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.hidden = false;
      }
      if (resultsEl) resultsEl.hidden = true;
    }

    submitBtn?.addEventListener("click", () => {
      if (errorEl) errorEl.hidden = true;

      const knownKm = parseFloat(distanceSelect?.value ?? "10");
      const h = parseInt(timeH?.value || "0", 10);
      const m = parseInt(timeM?.value || "0", 10);
      const s = parseInt(timeS?.value || "0", 10);
      if (Number.isNaN(h) || Number.isNaN(m) || Number.isNaN(s) || h < 0 || m < 0 || m > 59 || s < 0 || s > 59) {
        showError("פורמט זמן לא תקין (שעות:דקות:שניות).");
        return;
      }
      const knownSeconds = h * 3600 + m * 60 + s;
      if (knownSeconds <= 0) {
        showError("נא להזין זמן גדול מאפס.");
        return;
      }

      if (splitsBody) {
        splitsBody.innerHTML = DISTANCES.filter((d) => Math.abs(d.km - knownKm) > 0.01)
          .map((d) => {
            const predictedSeconds = knownSeconds * (d.km / knownKm) ** 1.06;
            return `<tr><td>${d.label}</td><td>${formatTime(predictedSeconds)}</td></tr>`;
          })
          .join("");
      }
      if (resultsEl) resultsEl.hidden = false;
    });
  })();

  // ---------- VO2max (Daniels-Gilbert) ----------
  (function vo2max() {
    const distanceSelect = document.getElementById("vo2-distance") as HTMLSelectElement | null;
    const customPanel = document.getElementById("vo2-custom-panel");
    const customInput = document.getElementById("vo2-custom") as HTMLInputElement | null;
    const submitBtn = document.getElementById("vo2-submit");
    const errorEl = document.getElementById("vo2-error");
    const resultsEl = document.getElementById("vo2-results");
    const resultLineEl = document.getElementById("vo2-result-line");
    const noteEl = document.getElementById("vo2-note");

    distanceSelect?.addEventListener("change", () => {
      if (customPanel) customPanel.hidden = distanceSelect.value !== "custom";
    });

    submitBtn?.addEventListener("click", () => {
      if (errorEl) errorEl.hidden = true;
      const fail = (msg: string) => showCalcError(errorEl, resultsEl, msg);

      let distanceKm: number;
      if (distanceSelect?.value === "custom") {
        const custom = numOrNull(customInput?.value ?? "");
        if (!custom || custom < 0.4 || custom > 100) {
          fail('נא להזין מרחק תקין בק"מ (0.4 עד 100).');
          return;
        }
        distanceKm = custom;
      } else {
        distanceKm = parseFloat(distanceSelect?.value ?? "10");
      }

      const totalSeconds = readHms(["vo2-time-h", "vo2-time-m", "vo2-time-s"]);
      if (totalSeconds === null || totalSeconds <= 0) {
        fail("פורמט זמן לא תקין (שעות:דקות:שניות).");
        return;
      }

      const vo2 = danielsVo2Max(distanceKm, totalSeconds);
      if (!Number.isFinite(vo2) || vo2 < 10 || vo2 > 95) {
        fail("התוצאה מחוץ לטווח הסביר. בדקו את המרחק והזמן שהוזנו.");
        return;
      }
      if (resultLineEl) resultLineEl.textContent = `VO₂max משוער: ${vo2.toFixed(1)} מ"ל/ק"ג/דקה`;

      // הנוסחה נבנתה על תוצאות של כ-3.5 דקות עד כ-4 שעות
      const minutes = totalSeconds / 60;
      if (noteEl) {
        noteEl.hidden = minutes >= 3.5 && minutes <= 240;
        noteEl.textContent = "שימו לב: הנוסחה נבנתה על תוצאות של כ-3.5 דקות עד כ-4 שעות, ולכן מחוץ לטווח הזה ההערכה פחות מדויקת.";
      }
      if (resultsEl) resultsEl.hidden = false;
    });
  })();


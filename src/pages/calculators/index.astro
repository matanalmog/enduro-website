    };
    const MIN_AGE = 18;
    const MAX_AGE = 90;

    const distanceSelect = document.getElementById("ag-distance") as HTMLSelectElement | null;
    const sexSelect = document.getElementById("ag-sex") as HTMLSelectElement | null;
    const ageInput = document.getElementById("ag-age") as HTMLInputElement | null;
    const submitBtn = document.getElementById("ag-submit");
    const errorEl = document.getElementById("ag-error");
    const resultsEl = document.getElementById("ag-results");
    const resultLineEl = document.getElementById("ag-result-line");
    const levelLineEl = document.getElementById("ag-level-line");
    const equivLineEl = document.getElementById("ag-equiv-line");

    function levelFor(pct: number): string {
      if (pct >= 100) return "ברמת שיא עולם לגיל (כדאי לבדוק שהנתונים הוזנו נכון)";
      if (pct >= 90) return "רמה עולמית";
      if (pct >= 80) return "רמה לאומית";
      if (pct >= 70) return "רמה אזורית";
      if (pct >= 60) return "רמה מקומית";
      return "רמת ריצה כללית (מתחת ל-60%)";
    }

    submitBtn?.addEventListener("click", () => {
      if (errorEl) errorEl.hidden = true;
      const fail = (msg: string) => showCalcError(errorEl, resultsEl, msg);

      const distKey = distanceSelect?.value ?? "10";
      const sex = sexSelect?.value === "F" ? "F" : "M";
      const age = numOrNull(ageInput?.value ?? "");
      if (age === null || !Number.isInteger(age) || age < MIN_AGE || age > MAX_AGE) {
        fail(`נא להזין גיל שלם בין ${MIN_AGE} ל-${MAX_AGE}.`);
        return;
      }
      const totalSeconds = readHms(["ag-time-h", "ag-time-m", "ag-time-s"]);
      if (totalSeconds === null || totalSeconds <= 0) {
        fail("פורמט זמן לא תקין (שעות:דקות:שניות).");
        return;
      }

      const table = AGE_DATA[sex];
      const factor = (table[distKey] as number[])[age - MIN_AGE];
      const openStandard = table.oc[distKey];
      const ageStandard = openStandard / factor; // זמן השיא לגיל ולמין
      const pct = (ageStandard / totalSeconds) * 100;
      const equivalent = totalSeconds * factor; // זמן שקול בגיל השיא

      if (resultLineEl) resultLineEl.textContent = `דירוג גיל: ${pct.toFixed(1)}%`;
      if (levelLineEl) levelLineEl.textContent = `רמה: ${levelFor(pct)}`;
      if (equivLineEl) equivLineEl.textContent = `זמן שקול בגיל השיא: ${formatTime(equivalent)} · זמן התקן לגיל ${age}: ${formatTime(ageStandard)}`;
      if (resultsEl) resultsEl.hidden = false;
    });
  })();

---
// תבנית כתבה בודדת בסדרת מרתון תל אביב. מבנה-אח של src/pages/blog/[slug].astro,
// עם תוספת ניווט קודם/הבא בסדרה (לפי weekNumber) ו-BreadcrumbList בסכימה.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("telAvivMarathon", ({ data }) => !data.draft);
  const sorted = [...posts].sort((a, b) => a.data.weekNumber - b.data.weekNumber);
  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: sorted[index - 1] ?? null,
      nextPost: sorted[index + 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<"telAvivMarathon">;
  prevPost: CollectionEntry<"telAvivMarathon"> | null;
  nextPost: CollectionEntry<"telAvivMarathon"> | null;
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);

function formatHebrewDate(date: Date) {
  return new Intl.DateTimeFormat("he-IL", { day: "numeric", month: "long", year: "numeric" }).format(date);
}

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.publishDate.toISOString(),
    "author": { "@type": "Person", "name": "תומר אלמוג" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "הכנה למרתון תל אביב 2027", "item": "https://www.sport4you.co.il/tel-aviv-marathon/" },
      { "@type": "ListItem", "position": 2, "name": post.data.title, "item": `https://www.sport4you.co.il/tel-aviv-marathon/${post.id}/` },
    ],
  },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/tel-aviv-marathon/${post.id}/`}
  ogType="article"
  ogImage={post.data.ogImage}
  schema={schema}
>
  <article class="container post">
    <p class="breadcrumb"><a href="/tel-aviv-marathon/">הכנה למרתון תל אביב 2027</a> / שבוע {post.data.weekNumber}</p>
    <p class="date">{formatHebrewDate(post.data.publishDate)}</p>
    <h1>{post.data.title}</h1>
    {post.data.ogImage && (
      <img class="post-image" src={post.data.ogImage} alt={post.data.title} />
    )}
    <div class="prose">
      <Content />
    </div>

    <nav class="series-nav" aria-label="ניווט בסדרה">
      {prevPost && (
        <a href={`/tel-aviv-marathon/${prevPost.id}/`} class="series-nav-link series-nav-prev">
          <span class="series-nav-label">הכתבה הקודמת</span>
          <span class="series-nav-title">{prevPost.data.title}</span>
        </a>
      )}
      {nextPost && (
        <a href={`/tel-aviv-marathon/${nextPost.id}/`} class="series-nav-link series-nav-next">
          <span class="series-nav-label">הכתבה הבאה</span>
          <span class="series-nav-title">{nextPost.data.title}</span>
        </a>
      )}
    </nav>

    <div class="post-cta">
      <p>רוצה תוכנית אישית למרתון תל אביב?</p>
      <a href="/?src=tlv-marathon-article#lead-form" class="btn btn-primary">בדקו התאמה לתוכנית אישית</a>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--space-5) var(--space-6);
    max-width: 720px;
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
  }

  .date {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-1);
  }

  .post-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    margin-block: var(--space-3);
  }

  .prose {
    margin-top: var(--space-3);
    line-height: 1.75;
  }

  .prose :global(h2) {
    margin-top: var(--space-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: 1.4em;
    margin-bottom: var(--space-2);
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(blockquote) {
    margin: var(--space-3) 0;
    padding: var(--space-2) var(--space-3);
    background: var(--color-gray-50);
    border-radius: var(--radius-md);
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    width: 100%;
    margin: var(--space-3) 0;
    font-size: 0.95rem;
  }

  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--color-gray-100);
    padding: 0.6rem 0.75rem;
    text-align: start;
    vertical-align: top;
  }

  .prose :global(th) {
    background: var(--color-gray-50);
  }

  .series-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .series-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: var(--space-3);
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .series-nav-link:hover,
  .series-nav-link:focus-visible {
    border-color: var(--color-brand);
    box-shadow: var(--shadow-md);
  }

  .series-nav-next {
    text-align: end;
  }

  .series-nav-label {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .series-nav-title {
    font-weight: 700;
  }

  .post-cta {
    margin-top: var(--space-4);
    padding: var(--space-3);
    background: var(--color-gray-50);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .post-cta p {
    margin-bottom: var(--space-2);
    font-weight: 600;
  }
</style>

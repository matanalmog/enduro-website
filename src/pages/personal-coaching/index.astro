---
// עמוד-שער ל"מאמן כושר אישי" — מפנה ל-4 העמודים (3 ערים + גיל שלישי; סעיף 2 באפיון).
import BaseLayout from "../../layouts/BaseLayout.astro";
import { personalCoachingPages } from "../../data/personal-coaching";

const sortedPages = [...personalCoachingPages].sort((a, b) => a.order - b.order);

// "למי מתאים" לכל כרטיס נשאב מתוך שאלת ה-FAQ הקיימת של כל עמוד (לא טקסט חדש) —
// כל 4 העמודים כוללים שאלת FAQ שמתחילה ב"למי מתאים", ראו src/data/personal-coaching.ts.
function getAudience(page: (typeof sortedPages)[number]) {
  return page.faq.find((f) => f.q.includes("למי מתאים"))?.a ?? "";
}
---

<BaseLayout
  title="מאמן כושר אישי"
  description="מאמן כושר אישי בליווי צמוד, תוכנית אימונים ותזונה מותאמת אישית. ברמת השרון, הרצליה, תל אביב, ובהתמחות לגיל השלישי."
  canonicalPath="/personal-coaching/"
>
  <section class="hero">
    <div class="container hero-inner">
      <h1>מאמן כושר אישי</h1>
      <p class="lead">
        ל-ENDURO כמה אפשרויות שונות לאימון כושר אישי, כל אחת בהתאמה
        לעיר ולקהל שלה — לא תוכנית ריצה אחת אלא ליווי אישי מלא: תוכנית
        אימונים ותזונה מותאמת, עד להשגת המטרה שלכם. בחרו את העיר
        שלכם, או את ההתמחות המתאימה:
      </p>
    </div>
  </section>

  <section class="container section">
    <div class="cities-grid">
      {sortedPages.map((page) => (
        <a href={`/personal-coaching/${page.slug}/`} class="city-card">
          <h2>{page.title}</h2>
          <p class="city-card-audience">{getAudience(page)}</p>
          <p class="city-card-desc">{page.intro[0]}</p>
          <span class="btn btn-primary city-card-cta">לפרטי האימון &larr;</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container section cta-band">
    <h2>לא בטוחים מה מתאים לכם?</h2>
    <p>בואו נתחיל עוד היום, השאירו פרטים ונבנה יחד את התוכנית הנכונה.</p>
    <div class="cta-actions">
      <a href="/#lead-form" class="btn btn-primary">השאירו פרטים</a>
      <a href="https://wa.me/972526982993" class="btn btn-outline" target="_blank" rel="noopener noreferrer">שלחו וואטסאפ</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-navy-950), var(--color-navy-900));
    color: var(--color-white);
  }

  .hero-inner {
    padding-block: var(--space-6) var(--space-5);
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }

  .hero h1 {
    color: var(--color-white);
  }

  .hero .lead {
    color: var(--color-gray-300);
    font-size: 1.05rem;
  }

  .section {
    padding-block: var(--space-5);
  }

  .cities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .city-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: var(--color-white);
    border: 1px solid var(--color-gray-100);
    border-top: 4px solid transparent;
    border-radius: var(--radius-md);
    padding: var(--space-3);
    text-decoration: none;
    color: var(--color-text);
    transition: box-shadow 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }

  .city-card:hover,
  .city-card:focus-visible {
    box-shadow: var(--shadow-md);
    border-color: var(--color-brand);
    border-top-color: var(--color-brand);
    transform: translateY(-3px);
  }

  .city-card h2 {
    font-size: 1.2rem;
    margin: 0;
  }

  .city-card-audience {
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.88rem;
    margin: 0;
  }

  .city-card-desc {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
    margin: 0;
  }

  .city-card-cta {
    pointer-events: none;
    align-self: flex-start;
    margin-top: auto;
    white-space: nowrap;
    padding-inline: 0.9rem;
    padding-block: 0.5rem;
    font-size: 0.85rem;
  }

  @media (max-width: 860px) {
    .cities-grid {
      grid-template-columns: 1fr;
    }
  }

  .cta-band {
    text-align: center;
    background: var(--color-navy-950);
    color: var(--color-white);
    border-radius: var(--radius-lg);
    padding-inline: var(--space-3);
  }

  .cta-band h2 {
    color: var(--color-white);
  }

  .cta-band p {
    color: var(--color-gray-300);
    margin-bottom: var(--space-3);
  }

  .cta-band .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
  }

  .cta-band .btn-outline {
    color: var(--color-white);
  }
</style>

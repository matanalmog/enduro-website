---
// עמוד קמפיין: הכנה למרתון תל אביב. כתובת בלי שנה בכוונה כדי לשרת גם אירועים עתידיים
// (ראו האפיון שאושר). פרטי האירוע (תאריך/מקצים) מאומתים מול tlvmarathon.co.il — יש
// לבדוק מחדש לפני כל עדכון עתידי, הם לא קבועים כמו שאר תוכן העמוד. קוד הנחה לא נכלל
// בכוונה עד שתוקפו יאושר (ראו races.astro לקוד 785859 הקיים, לא מיובא לכאן).
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqItem from "../components/FaqItem.astro";

const ctaHref = "/?src=tlv-marathon#lead-form";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "מתי מרתון תל אביב 2027?",
        "acceptedAnswer": { "@type": "Answer", "text": "26 בפברואר 2027, לפי האתר הרשמי של האירוע." },
      },
      {
        "@type": "Question",
        "name": "אילו מקצים יש באירוע?",
        "acceptedAnswer": { "@type": "Answer", "text": "מרתון מלא, חצי מרתון, 10 ק\"מ, 5 ק\"מ, מרוץ אופני יד ומיני מרתון ילדים." },
      },
      {
        "@type": "Question",
        "name": "כמה זמן מראש כדאי להתחיל להתכונן למרתון תל אביב?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "תלוי במקצה ובבסיס הריצה שלכם. חשוב להשאיר מספיק זמן לבנייה הדרגתית ולהתאוששות בין אימונים, ולא רק לספירת שבועות עד האירוע.",
        },
      },
      {
        "@type": "Question",
        "name": "אפשר להתחיל מאפס ולהגיע למרתון תל אביב 2027?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "תלוי כמה זמן נשאר וכמה ניסיון ריצה יש לכם היום. למי שמתחיל מאפס ממש, מקצה קצר יותר (5 או 10 ק\"מ) עשוי להיות יעד מתאים יותר בשלב הזה — זו בדיוק השאלה שכדאי לברר בשיחת היכרות.",
        },
      },
      {
        "@type": "Question",
        "name": "מה ההבדל בין הכנה לרץ מתחיל למנוסה?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "בעיקר קצב ההעלאה בנפח הריצה ומידת ההיכרות עם אימוני איכות (אינטרוולים, אימוני סף). לרץ מתחיל מתאים קצב הדרגתי יותר.",
        },
      },
    ],
  },
];
---

<BaseLayout
  title="הכנה למרתון תל אביב 2027"
  description="כל המידע על מרתון תל אביב 2027 (26.2.2027) — מקצים, לוח הכנה לפי מרחק ומחשבון קצבים. בליווי תוכנית ריצה אונליין אישית מתומר אלמוג, ENDURO."
  canonicalPath="/tel-aviv-marathon/"
  schema={schema}
>
  <section class="hero">
    <div class="container hero-inner">
      <h1>הכנה למרתון תל אביב 2027 — כל המקצים, בליווי אישי</h1>
      <p class="lead">
        מרתון תל אביב הבא הוא ב-26.2.2027. בין אם המטרה שלכם היא 5 ק"מ, 10
        ק"מ, חצי מרתון או המרתון המלא — כאן תמצאו מידע מאומת על האירוע, לוח
        הכנה כללי, מחשבון קצבים, וגם איך תוכנית ריצה אונליין אישית יכולה
        ללוות אתכם עד הקו.
      </p>
      <div class="hero-actions">
        <a href={ctaHref} class="btn btn-primary">בדקו התאמה לתוכנית אישית &larr;</a>
      </div>
    </div>
  </section>

  <section class="container section">
    <h2>על מרתון תל אביב 2027</h2>
    <p>
      מרתון תל אביב 2027 ייערך ב-<strong>26 בפברואר 2027</strong>. האירוע כולל
      מספר מקצים במרחקים שונים, כך שיש אפשרות להשתתף כמעט מכל רמת ריצה.
    </p>
    <ul class="plain-list">
      <li><strong>תאריך:</strong> 26.2.2027</li>
      <li><strong>מקצים:</strong> מרתון, חצי מרתון, 10 ק"מ, 5 ק"מ, מרוץ אופני יד, מיני מרתון ילדים</li>
      <li>
        <strong>הרשמה ומידע רשמי:</strong>
        <a href="https://www.tlvmarathon.co.il" target="_blank" rel="noopener noreferrer">tlvmarathon.co.il</a>
      </li>
      <li><strong>קוד הנחה לקבוצה:</strong> <span dir="ltr">ENDURO: 785859</span></li>
    </ul>
    <p class="source-note">
      מידע זה מבוסס על האתר הרשמי של האירוע, נבדק לאחרונה ב-21.9.2026. פרטי
      אירועים עשויים להשתנות — מומלץ לוודא באתר הרשמי סמוך למועד ההרשמה.
    </p>
  </section>

  <section class="container section section-muted">
    <h2>מקצי הריצה</h2>
    <div class="distances-grid">
      <div class="distance-card">
        <h3>5 ק"מ ו-10 ק"מ</h3>
        <p>מקצים נגישים למתחילים וגם למי שרוצה לשפר זמן אישי. נקודת התחלה טובה למי שעדיין לא רץ מרחקים ארוכים.</p>
      </div>
      <div class="distance-card">
        <h3>חצי מרתון</h3>
        <p>21.0975 ק"מ. דורש בסיס ריצה סדיר של כמה חודשים לפחות, ומתאים גם לרצים שכבר סיימו 10 ק"מ ורוצים לעלות מדרגה.</p>
      </div>
      <div class="distance-card">
        <h3>מרתון מלא</h3>
        <p>42.195 ק"מ. דורש תקופת הכנה ארוכה ובסיס ריצה מבוסס. ההתאמה תלויה בבסיס האימונים האישי שלכם, לא בכלל אחיד לכולם.</p>
      </div>
    </div>
    <p class="source-note">
      האירוע כולל גם מרוץ אופני יד ומיני מרתון ילדים — לא בפוקוס ההכנה כאן,
      שמתמקדת בארבעת מקצי הריצה למבוגרים.
    </p>
  </section>

  <section class="container section" id="prep-table">
    <h2>לוח הכנה כללי לפי מקצה</h2>
    <p class="section-note">
      זהו מידע כללי לרצים עם בסיס מתאים — לא הבטחת מוכנות ולא תחליף לתוכנית
      אישית. טווחי הזמן תלויים בבסיס הריצה ובניסיון האישיים: רץ עם רקע
      ספורטיבי אחר עשוי להתקדם מהר יותר, ורץ שמתחיל מאפס עשוי להזדקק ליותר
      זמן.
    </p>
    <div class="table-wrap">
      <table class="prep-table">
        <thead>
          <tr>
            <th>מקצה</th>
            <th>טווח הכנה כללי</th>
            <th>מתאים בדרך כלל ל-</th>
            <th>סוגי אימונים מרכזיים</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>5 ק"מ</td>
            <td>כ-6–8 שבועות למתחילים; גמיש למנוסים</td>
            <td>מי שרוצה להתחיל לרוץ באופן סדיר</td>
            <td>הליכה-ריצה, ריצות קלות, כוח בסיסי</td>
          </tr>
          <tr>
            <td>10 ק"מ</td>
            <td>כ-8–10 שבועות</td>
            <td>מי שכבר רץ 5 ק"מ בנוחות</td>
            <td>אינטרוולים קלים, ריצות ארוכות הדרגתיות</td>
          </tr>
          <tr>
            <td>חצי מרתון</td>
            <td>כ-10–16 שבועות, תלוי בבסיס</td>
            <td>רצים עם הרגל ריצה סדיר של כמה חודשים</td>
            <td>ריצות ארוכות מתקדמות, אימוני סף</td>
          </tr>
          <tr>
            <td>מרתון מלא</td>
            <td>כ-14–20 שבועות, תלוי בבסיס</td>
            <td>רצים עם בסיס אימונים מבוסס</td>
            <td>ריצות ארוכות בהתקדמות הדרגתית, טייפר לפני המרוץ</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="source-note">
      הטווחים לעיל להתמצאות כללית בלבד. גורמים כמו בריאות, זמן פנוי והרגלי
      אימון קודמים משפיעים על הקצב הנכון עבורכם — לכן זה מידע כללי, לא הבטחה.
    </p>
    <div class="cta-band">
      <p>רוצים תוכנית שמתאימה בדיוק לבסיס שלכם, לא טבלה כללית?</p>
      <a href={ctaHref} class="btn btn-primary">בדקו התאמה לתוכנית אישית &larr;</a>
    </div>
  </section>

  <section class="container section section-muted" id="pace-calculator">
    <h2>מחשבון קצבים וזמני סיום</h2>
    <p class="section-note">בחרו מקצה, הזינו זמן יעד או קצב רצוי, וקבלו את הערך השני וטבלת זמני ביניים.</p>

    <div class="calculator">
      <div class="calc-row">
        <label for="calc-distance">מקצה</label>
        <select id="calc-distance">
          <option value="5">5 ק"מ</option>
          <option value="10">10 ק"מ</option>
          <option value="21.0975" selected>חצי מרתון</option>
          <option value="42.195">מרתון מלא</option>
        </select>
      </div>

      <div class="calc-mode-toggle" role="tablist" aria-label="בחירת אופן חישוב">
        <button type="button" class="calc-mode-btn is-active" data-mode="time" role="tab" aria-selected="true">יש לי זמן יעד</button>
        <button type="button" class="calc-mode-btn" data-mode="pace" role="tab" aria-selected="false">יש לי קצב</button>
      </div>

      <div class="calc-panel" data-panel="time">
        <label id="calc-time-label">זמן יעד (שעות : דקות : שניות)</label>
        <div class="calc-time-inputs" role="group" aria-labelledby="calc-time-label">
          <input type="number" id="calc-time-h" min="0" max="9" placeholder="שע" inputmode="numeric" aria-label="שעות" />
          <span aria-hidden="true">:</span>
          <input type="number" id="calc-time-m" min="0" max="59" placeholder="דק" inputmode="numeric" aria-label="דקות" />
          <span aria-hidden="true">:</span>
          <input type="number" id="calc-time-s" min="0" max="59" placeholder="שנ" inputmode="numeric" aria-label="שניות" />
        </div>
      </div>

      <div class="calc-panel" data-panel="pace" hidden>
        <label id="calc-pace-label">קצב (דקות : שניות לק"מ)</label>
        <div class="calc-time-inputs" role="group" aria-labelledby="calc-pace-label">
          <input type="number" id="calc-pace-m" min="0" max="59" placeholder="דק" inputmode="numeric" aria-label="דקות לק&quot;מ" />
          <span aria-hidden="true">:</span>
          <input type="number" id="calc-pace-s" min="0" max="59" placeholder="שנ" inputmode="numeric" aria-label="שניות לק&quot;מ" />
        </div>
      </div>

      <button type="button" id="calc-submit" class="btn btn-primary">חשבו</button>

      <p id="calc-error" class="calc-error" role="alert" hidden></p>

      <div id="calc-results" class="calc-results" hidden>
        <p id="calc-result-line" class="calc-result-line"></p>
        <div class="table-wrap">
          <table class="calc-splits">
            <thead><tr><th>מרחק</th><th>זמן ביניים</th></tr></thead>
            <tbody id="calc-splits-body"></tbody>
          </table>
        </div>
      </div>

      <p class="calc-disclaimer">
        החישוב מניח קצב אחיד (יציב) לאורך כל המקצה. בפועל הקצב עשוי להשתנות
        בהתאם לתנאי המסלול, מזג האוויר והעייפות.
      </p>
    </div>
  </section>

  <section class="container section" id="coaching">
    <h2>איך עובד הליווי עם ENDURO</h2>
    <div class="coaching-grid">
      <div>
        <h3>למי זה מתאים</h3>
        <p>לרצים בכל רמה שרוצים תוכנית שמתאימה אליהם באמת — ולא ההפך. בין אם זו הפעם הראשונה שלכם על קו הזינוק או שאתם מחפשים לשפר זמן אישי.</p>
      </div>
      <div>
        <h3>מה כולל הליווי</h3>
        <p>תוכנית אימונים אישית באפליקציה, מעקב שוטף אחרי האימונים, והתאמות לפי ההתקדמות שלכם והחיים שמחוץ לריצה.</p>
      </div>
      <div>
        <h3>איך פונים</h3>
        <p>משאירים פרטים, ותומר חוזר לשיחת היכרות קצרה כדי להבין את המטרה והבסיס שלכם לפני שבונים תוכנית.</p>
      </div>
    </div>
  </section>

  <section class="container section section-muted" id="faq">
    <h2>שאלות נפוצות</h2>
    <div class="faq-list">
      <FaqItem question="מתי מרתון תל אביב 2027?">
        <p><span class="faq-tag faq-tag-fact">עובדה</span> 26 בפברואר 2027, לפי האתר הרשמי של האירוע.</p>
      </FaqItem>
      <FaqItem question="אילו מקצים יש באירוע?">
        <p><span class="faq-tag faq-tag-fact">עובדה</span> מרתון מלא, חצי מרתון, 10 ק"מ, 5 ק"מ, מרוץ אופני יד ומיני מרתון ילדים.</p>
      </FaqItem>
      <FaqItem question="כמה זמן מראש כדאי להתחיל להתכונן?">
        <p>
          <span class="faq-tag faq-tag-advice">דעת מאמן</span> תלוי במקצה ובבסיס
          הריצה שלכם — ראו לוח ההכנה הכללי למעלה. חשוב להשאיר מספיק זמן
          לבנייה הדרגתית ולהתאוששות בין אימונים, לא רק לספור שבועות עד
          האירוע.
        </p>
      </FaqItem>
      <FaqItem question="אפשר להתחיל מאפס ולהגיע למרתון תל אביב 2027?">
        <p>
          <span class="faq-tag faq-tag-advice">דעת מאמן</span> תלוי כמה זמן
          נשאר וכמה ניסיון ריצה יש לכם היום. למי שמתחיל מאפס ממש, מקצה קצר
          יותר (5 או 10 ק"מ) עשוי להיות יעד מתאים יותר בשלב הזה — זו בדיוק
          השאלה שכדאי לברר בשיחת היכרות לפני שקובעים יעד.
        </p>
      </FaqItem>
      <FaqItem question="מה ההבדל בין הכנה לרץ מתחיל למנוסה?">
        <p><span class="faq-tag faq-tag-advice">דעת מאמן</span> בעיקר קצב ההעלאה בנפח הריצה ומידת ההיכרות עם אימוני איכות (אינטרוולים, אימוני סף). לרץ מתחיל מתאים קצב הדרגתי יותר.</p>
      </FaqItem>
    </div>
  </section>

  <section class="container section">
    <h2>קישורים נוספים</h2>
    <ul class="links-list">
      <li><a href="/training-plans/">תוכניות ריצה אונליין — כל המסלולים</a></li>
      <li><a href="/training-plans/half-marathon/">תוכנית לחצי מרתון</a></li>
      <li><a href="/training-plans/marathon/">תוכנית למרתון</a></li>
      <li><a href="/training-plans/beginners/">תוכנית למתחילים</a></li>
      <li><a href="/races/">לוח התחרויות המלא של ENDURO</a></li>
      <li><a href="/about-me/">מי מאמן אתכם — עמוד אודות</a></li>
    </ul>
  </section>

  <section class="container section cta-band cta-band-final">
    <h2>המרוץ הבא שלכם מתחיל בתוכנית שמתאימה לכם.</h2>
    <a href={ctaHref} class="btn btn-primary">בדקו התאמה לתוכנית אישית &larr;</a>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-navy-950), var(--color-navy-900));
    color: var(--color-white);
  }

  .hero-inner {
    padding-block: var(--space-6) var(--space-5);
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }

  .hero h1 {
    color: var(--color-white);
    font-size: clamp(1.5rem, 3.2vw, 2.1rem);
    text-wrap: pretty;
  }

  .hero .lead {
    color: var(--color-gray-300);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 65ch;
    margin-inline: auto;
  }

  .hero-actions {
    margin-top: var(--space-3);
  }

  .section {
    padding-block: var(--space-5);
  }

  .section-muted {
    background: var(--color-gray-50);
  }

  .section-note {
    color: var(--color-text-muted);
    max-width: 70ch;
    margin-bottom: var(--space-3);
  }

  .source-note {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-style: italic;
    margin-top: var(--space-2);
  }

  .plain-list {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-white);
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .plain-list li {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-gray-100);
    font-size: 0.95rem;
  }

  .plain-list li:last-child {
    border-bottom: none;
  }

  .distances-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .distance-card {
    background: var(--color-white);
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-md);
    padding: var(--space-3);
  }

  .distance-card h3 {
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
  }

  .distance-card p {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    margin: 0;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .prep-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    background: var(--color-white);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .prep-table th,
  .prep-table td {
    text-align: right;
    padding: var(--space-2);
    border-bottom: 1px solid var(--color-gray-100);
    vertical-align: top;
  }

  .prep-table th {
    background: var(--color-gray-50);
    font-size: 0.78rem;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .cta-band {
    text-align: center;
    background: var(--color-navy-950);
    color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-3);
    margin-top: var(--space-4);
  }

  .cta-band p {
    color: var(--color-gray-300);
    margin-bottom: var(--space-3);
  }

  .cta-band-final h2 {
    color: var(--color-white);
    margin-bottom: var(--space-3);
  }

  /* מחשבון קצבים */
  .calculator {
    max-width: 520px;
    background: var(--color-white);
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }

  .calc-row {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: var(--space-3);
  }

  .calc-row label {
    font-weight: 700;
    font-size: 0.9rem;
  }

  .calc-row select {
    font: inherit;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-gray-300);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    min-height: 44px;
  }

  .calc-mode-toggle {
    display: flex;
    gap: 0.4rem;
    margin-bottom: var(--space-3);
  }

  .calc-mode-btn {
    flex: 1;
    font: inherit;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.6rem 0.5rem;
    border: 1px solid var(--color-gray-300);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-text);
    cursor: pointer;
    min-height: 44px;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .calc-mode-btn.is-active {
    background: var(--color-navy-950);
    border-color: var(--color-navy-950);
    color: var(--color-white);
  }

  .calc-panel {
    margin-bottom: var(--space-3);
  }

  .calc-panel label {
    display: block;
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 0.4rem;
  }

  .calc-time-inputs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .calc-time-inputs input {
    flex: 1;
    min-width: 0;
    font: inherit;
    text-align: center;
    padding: 0.65rem 0.4rem;
    border: 1px solid var(--color-gray-300);
    border-radius: var(--radius-sm);
    min-height: 44px;
  }

  .calc-time-inputs span {
    font-weight: 700;
    color: var(--color-text-muted);
  }

  #calc-submit {
    width: 100%;
    min-height: 44px;
  }

  .calc-error {
    color: var(--color-orange-600, #a5411f);
    background: var(--color-orange-100, #f7e2da);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.8rem;
    font-size: 0.88rem;
    margin-top: var(--space-2);
  }

  .calc-results {
    margin-top: var(--space-3);
  }

  .calc-result-line {
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--color-navy-950);
    margin-bottom: var(--space-2);
  }

  .calc-splits {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .calc-splits th,
  .calc-splits td {
    text-align: right;
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--color-gray-100);
  }

  .calc-disclaimer {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-style: italic;
    margin-top: var(--space-3);
    margin-bottom: 0;
  }

  .coaching-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .coaching-grid h3 {
    font-size: 1rem;
    margin: 0 0 0.4rem;
  }

  .coaching-grid p {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    margin: 0;
  }

  .faq-list {
    max-width: 760px;
  }

  .faq-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: 4px;
    padding: 1px 8px;
    margin-inline-end: 6px;
  }

  .faq-tag-fact {
    background: #fbf0d9;
    color: #8a6415;
  }

  .faq-tag-advice {
    background: var(--color-orange-100, #f7e2da);
    color: var(--color-orange-600, #a5411f);
  }

  .links-list {
    columns: 2;
    column-gap: var(--space-4);
    max-width: 700px;
    margin: 0;
    padding-inline-start: 1.2em;
  }

  .links-list li {
    margin-bottom: 0.5rem;
    break-inside: avoid;
  }

  @media (max-width: 560px) {
    .links-list {
      columns: 1;
    }
  }
</style>

<script>
  const distanceSelect = document.getElementById("calc-distance") as HTMLSelectElement | null;
  const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".calc-mode-btn"));
  const timePanel = document.querySelector<HTMLDivElement>('[data-panel="time"]');
  const pacePanel = document.querySelector<HTMLDivElement>('[data-panel="pace"]');

  const timeH = document.getElementById("calc-time-h") as HTMLInputElement | null;
  const timeM = document.getElementById("calc-time-m") as HTMLInputElement | null;
  const timeS = document.getElementById("calc-time-s") as HTMLInputElement | null;
  const paceM = document.getElementById("calc-pace-m") as HTMLInputElement | null;
  const paceS = document.getElementById("calc-pace-s") as HTMLInputElement | null;

  const submitBtn = document.getElementById("calc-submit");
  const errorEl = document.getElementById("calc-error");
  const resultsEl = document.getElementById("calc-results");
  const resultLineEl = document.getElementById("calc-result-line");
  const splitsBody = document.getElementById("calc-splits-body");

  let mode: "time" | "pace" = "time";

  modeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      mode = btn.dataset.mode === "pace" ? "pace" : "time";
      modeButtons.forEach((b) => {
        b.classList.toggle("is-active", b === btn);
        b.setAttribute("aria-selected", String(b === btn));
      });
      if (timePanel) timePanel.hidden = mode !== "time";
      if (pacePanel) pacePanel.hidden = mode !== "pace";
    });
  });

  function showError(message: string) {
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.hidden = false;
    }
    if (resultsEl) resultsEl.hidden = true;
  }

  function formatTime(totalSecondsExact: number): string {
    const totalSeconds = Math.round(totalSecondsExact);
    const h = Math.floor(totalSeconds / 3600);
    const m = Math.floor((totalSeconds % 3600) / 60);
    const s = totalSeconds % 60;
    const pad = (n: number) => String(n).padStart(2, "0");
    return h > 0 ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
  }

  function formatPace(secondsPerKmExact: number): string {
    const rounded = Math.round(secondsPerKmExact);
    const m = Math.floor(rounded / 60);
    const s = rounded % 60;
    return `${m}:${String(s).padStart(2, "0")}`;
  }

  function splitPointsFor(distance: number): number[] {
    if (distance === 5) return [1, 2, 3, 4, 5];
    if (distance === 10) return [2, 4, 6, 8, 10];
    if (distance === 21.0975) return [5, 10, 15, 20, 21.0975];
    if (distance === 42.195) return [10, 21.0975, 30, 42.195];
    return [distance];
  }

  function formatKm(km: number): string {
    // תצוגה בלבד מעוגלת לעשירית (21.0975 -> "21.1") — חישוב הזמן עצמו משתמש בערך המדויק.
    return Number.isInteger(km) ? `${km} ק"מ` : `${km.toFixed(1)} ק"מ`;
  }

  submitBtn?.addEventListener("click", () => {
    if (errorEl) errorEl.hidden = true;

    const distance = parseFloat(distanceSelect?.value ?? "21.0975");
    let paceSecondsPerKmExact: number; // לא מעוגל — כל חישובי הביניים משתמשים בערך הזה
    let totalSecondsExact: number;

    if (mode === "time") {
      const h = parseInt(timeH?.value || "0", 10);
      const m = parseInt(timeM?.value || "0", 10);
      const s = parseInt(timeS?.value || "0", 10);
      if (
        Number.isNaN(h) || Number.isNaN(m) || Number.isNaN(s) ||
        h < 0 || m < 0 || m > 59 || s < 0 || s > 59
      ) {
        showError('פורמט זמן לא תקין (שעות:דקות:שניות).');
        return;
      }
      totalSecondsExact = h * 3600 + m * 60 + s;
      if (totalSecondsExact <= 0) {
        showError("נא להזין זמן יעד גדול מאפס.");
        return;
      }
      paceSecondsPerKmExact = totalSecondsExact / distance;
    } else {
      const m = parseInt(paceM?.value || "0", 10);
      const s = parseInt(paceS?.value || "0", 10);
      if (Number.isNaN(m) || Number.isNaN(s) || m < 0 || s < 0 || s > 59) {
        showError('פורמט קצב לא תקין (דקות:שניות לק"מ).');
        return;
      }
      paceSecondsPerKmExact = m * 60 + s;
      if (paceSecondsPerKmExact <= 0) {
        showError("קצב חייב להיות גדול מאפס.");
        return;
      }
      totalSecondsExact = paceSecondsPerKmExact * distance;
    }

    if (resultLineEl) {
      resultLineEl.textContent =
        mode === "time"
          ? `קצב: ${formatPace(paceSecondsPerKmExact)} לק"מ`
          : `זמן סיום: ${formatTime(totalSecondsExact)}`;
    }

    if (splitsBody) {
      splitsBody.innerHTML = splitPointsFor(distance)
        .map((km) => {
          const splitSecondsExact = km * paceSecondsPerKmExact; // מהערך המדויק, לא מהקצב המעוגל
          return `<tr><td>${formatKm(km)}</td><td>${formatTime(splitSecondsExact)}</td></tr>`;
        })
        .join("");
    }

    if (resultsEl) resultsEl.hidden = false;
  });
</script>

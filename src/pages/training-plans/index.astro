---
// עמוד-שער לתוכניות האימון — מפנה לחמשת התתי-עמודים (סעיף 2 באפיון).
import BaseLayout from "../../layouts/BaseLayout.astro";
import { trainingPlans } from "../../data/training-plans";

const beginnersPlan = trainingPlans.find((p) => p.slug === "beginners")!;
const halfMarathonPlan = trainingPlans.find((p) => p.slug === "half-marathon")!;
const marathonPlan = trainingPlans.find((p) => p.slug === "marathon")!;
const ultraMarathonPlan = trainingPlans.find((p) => p.slug === "ultra-marathon")!;

const sortedPlans = [
  {
    slug: beginnersPlan.slug,
    distanceLabel: "מתחילים עד 10 ק\"מ",
    title: "תוכנית אימונים מתחילים עד 10 ק\"מ",
    audience: beginnersPlan.audience,
    price: beginnersPlan.price,
  },
  {
    slug: halfMarathonPlan.slug,
    distanceLabel: halfMarathonPlan.distanceLabel,
    title: halfMarathonPlan.title,
    audience: halfMarathonPlan.audience,
    price: halfMarathonPlan.price,
  },
  {
    slug: marathonPlan.slug,
    distanceLabel: marathonPlan.distanceLabel,
    title: marathonPlan.title,
    audience: marathonPlan.audience,
    price: marathonPlan.price,
  },
  {
    slug: ultraMarathonPlan.slug,
    distanceLabel: ultraMarathonPlan.distanceLabel,
    title: ultraMarathonPlan.title,
    audience: ultraMarathonPlan.audience,
    price: ultraMarathonPlan.price,
  },
];
---

<BaseLayout
  title="תוכניות אימון ריצה אונליין"
  description="תוכניות אימון ריצה אונליין בליווי אישי, ממתחילים ועד אולטרה מרתון. בחרו את המסלול המתאים לכם והשאירו פרטים."
  canonicalPath="/training-plans/"
>
  <section class="hero">
    <div class="container hero-inner">
      <h1>תוכניות אימון ריצה אונליין</h1>
      <p class="lead">
        ארבעה מסלולי ליווי אישי, מהצעד הראשון ועד אולטרה מרתון. כל
        תוכנית מותאמת אישית לרמה, למטרה ולזמינות שלכם.
      </p>
    </div>
  </section>

  <section class="container section platform-section">
    <h2>ככה נראית התוכנית שלכם בפועל</h2>
    <p class="platform-intro">
      לא PDF גנרי — תוכנית דיגיטלית חיה באפליקציה, מחוברת לשעון הריצה שלכם.
      כל אימון מתועד, כל ריצה מנותחת, וההתקדמות שלכם מול התוכנית המקורית
      גלויה לשנינו בזמן אמת.
    </p>
    <div class="platform-grid">
      {[
        {
          src: "/images/training-plans/platform-calendar.jpg",
          alt: "לוח אימונים שבועי באפליקציה, עם אימונים מתוכננים ומבוצעים",
          caption: "הלוח השבועי שלך",
        },
        {
          src: "/images/training-plans/platform-workout-detail.jpg",
          alt: "פירוט אימון בודד: מפת מסלול, זמן, דופק וכוח",
          caption: "פירוט מלא לכל אימון",
        },
        {
          src: "/images/training-plans/platform-analysis.jpg",
          alt: "ניתוח ריצה לפי קילומטרים: קצב, דופק וכוח, לצד מפה ופרופיל גובה",
          caption: "ניתוח מתוכנן מול בפועל",
        },
      ].map((img) => (
        <button
          type="button"
          class="platform-item"
          data-lightbox-src={img.src}
          data-lightbox-alt={img.alt}
          aria-haspopup="dialog"
        >
          <img src={img.src} alt={img.alt} loading="lazy" />
          <span>{img.caption}</span>
        </button>
      ))}
    </div>

    <dialog class="lightbox" id="platform-lightbox" aria-label="תצוגה מוגדלת של מסך האפליקציה">
      <button type="button" class="lightbox-close" aria-label="סגירת התצוגה המוגדלת">&times;</button>
      <img id="platform-lightbox-img" src="" alt="" />
    </dialog>
  </section>

  <section class="container section">
    <div class="plans-grid">
      {sortedPlans.map((plan) => (
        <a href={`/training-plans/${plan.slug}/`} class="plan-card">
          <span class="distance">{plan.distanceLabel}</span>
          <h2>{plan.title}</h2>
          <p class="audience">{plan.audience}</p>
          <div class="plan-card-footer">
            {plan.price && <span class="price">{plan.price} <span class="price-unit">לחודש</span></span>}
            <span class="btn btn-primary plan-card-cta">לפרטי המסלול &larr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container section cta-band">
    <h2>לא בטוחים איזה מסלול מתאים לכם?</h2>
    <p>בואו נתחיל עוד היום, השאירו פרטים ונבנה יחד את התוכנית המתאימה לכם.</p>
    <div class="cta-actions">
      <a href="/#lead-form" class="btn btn-primary">השאירו פרטים</a>
      <a href="https://wa.me/972526982993" class="btn btn-outline" target="_blank" rel="noopener noreferrer">שלחו וואטסאפ</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-navy-950), var(--color-navy-900));
    color: var(--color-white);
  }

  .hero-inner {
    padding-block: var(--space-6) var(--space-5);
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }

  .hero h1 {
    color: var(--color-white);
  }

  .hero .lead {
    color: var(--color-gray-300);
    font-size: 1.05rem;
  }

  .section {
    padding-block: var(--space-5);
  }

  .platform-section {
    text-align: center;
  }

  .platform-intro {
    max-width: 62ch;
    margin-inline: auto;
    color: var(--color-text-muted);
  }

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-4);
    text-align: start;
  }

  .platform-item {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-text);
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  .platform-item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-gray-100);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .platform-item:hover img,
  .platform-item:focus-visible img {
    border-color: var(--color-brand);
    transform: translateY(-2px);
  }

  .platform-item span {
    text-align: center;
    font-weight: 700;
    font-size: 0.92rem;
  }

  @media (max-width: 780px) {
    .platform-grid {
      grid-template-columns: 1fr;
      max-width: 420px;
      margin-inline: auto;
    }
  }

  .plans-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .plan-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: var(--color-white);
    border: 1px solid var(--color-gray-100);
    border-top: 4px solid transparent;
    border-radius: var(--radius-md);
    padding: var(--space-3);
    text-decoration: none;
    color: var(--color-text);
    transition: box-shadow 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }

  .plan-card:hover,
  .plan-card:focus-visible {
    box-shadow: var(--shadow-md);
    border-color: var(--color-brand);
    border-top-color: var(--color-brand);
    transform: translateY(-3px);
  }

  .distance {
    color: var(--color-brand-hover);
    font-weight: 800;
    font-size: 0.85rem;
  }

  .plan-card h2 {
    font-size: 1.2rem;
    margin: 0;
  }

  .plan-card .audience {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
    margin: 0;
  }

  .plan-card-footer {
    margin-top: auto;
    padding-top: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    border-top: 1px solid var(--color-gray-100);
  }

  .price {
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--color-navy-950);
  }

  .price-unit {
    font-weight: 600;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .plan-card-cta {
    pointer-events: none;
    white-space: nowrap;
    padding: 0.5rem 0.9rem;
    font-size: 0.85rem;
  }

  .cta-band {
    text-align: center;
    background: var(--color-navy-950);
    color: var(--color-white);
    border-radius: var(--radius-lg);
    padding-inline: var(--space-3);
  }

  .cta-band h2 {
    color: var(--color-white);
  }

  .cta-band p {
    color: var(--color-gray-300);
    margin-bottom: var(--space-3);
  }

  .cta-band .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
  }

  .cta-band .btn-outline {
    color: var(--color-white);
  }

  @media (max-width: 860px) {
    .plans-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .plan-card-footer {
      flex-direction: column;
      align-items: stretch;
    }

    .plan-card-cta {
      text-align: center;
    }
  }

  .lightbox {
    position: relative;
    border: none;
    border-radius: var(--radius-lg);
    padding: 0;
    max-width: min(90vw, 900px);
    max-height: 90vh;
    background: var(--color-white);
    box-shadow: var(--shadow-md);
  }

  .lightbox::backdrop {
    background: rgba(11, 18, 32, 0.8);
  }

  .lightbox img {
    display: block;
    width: 100%;
    max-height: 90vh;
    object-fit: contain;
  }

  .lightbox-close {
    position: absolute;
    top: var(--space-2);
    inset-inline-end: var(--space-2);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: var(--color-navy-950);
    color: var(--color-white);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .lightbox-close:hover,
  .lightbox-close:focus-visible {
    background: var(--color-brand);
  }
</style>

<script>
  const platformLightbox = document.getElementById("platform-lightbox");
  if (platformLightbox instanceof HTMLDialogElement) {
    const lightboxImg = document.getElementById("platform-lightbox-img");
    document.querySelectorAll(".platform-item").forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = btn.getAttribute("data-lightbox-src");
        const alt = btn.getAttribute("data-lightbox-alt");
        if (lightboxImg && src) {
          lightboxImg.setAttribute("src", src);
          lightboxImg.setAttribute("alt", alt ?? "");
        }
        platformLightbox.showModal();
      });
    });

    platformLightbox.querySelector(".lightbox-close")?.addEventListener("click", () => platformLightbox.close());

    platformLightbox.addEventListener("click", (event) => {
      if (event.target === platformLightbox) platformLightbox.close();
    });
  }
</script>

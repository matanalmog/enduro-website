---
// "אפליקציית אימון": הסבר על מערכת האימונים וסוגי האימונים, עם קישור לכניסה למערכת Final Surge.
// התוכן נשלט מ-src/data/training-app.ts. הדף לא מיועד לחיפוש (noindex) עד שהטקסטים המפורטים יאושרו.
import BaseLayout from "../layouts/BaseLayout.astro";
import AppBlocks from "../components/AppBlocks.astro";
import { FINAL_SURGE_LOGIN_URL, systemItems, trainingTypes, qualityPrep } from "../data/training-app";
---

<BaseLayout
  title="אפליקציית אימון"
  description="איך עובדת מערכת האימונים של ENDURO ב-Final Surge, ומה הם סוגי האימונים שתפגשו בה."
  canonicalPath="/training-app/"
  noindex
>
  <section class="container section app">
    <h1>אפליקציית אימון</h1>
    <p class="lead">
      כאן מוסבר איך עובדת מערכת האימונים, ומה כל סוג אימון אומר.
    </p>

    <div class="login-box">
      <div>
        <strong>כבר יש לך חשבון?</strong>
        <span>הכניסה ל-Final Surge, שבה רואים את האימונים ומדווחים עליהם.</span>
      </div>
      <a class="btn btn-primary" href={FINAL_SURGE_LOGIN_URL} target="_blank" rel="noopener">כניסה למערכת Final Surge</a>
    </div>
    <p class="first-time">
      עוד לא נרשמת או לא חיברת שעון? <a href="/start-here/">חיבור אפליקציות</a>.
    </p>

    <div class="topics" role="tablist" aria-label="נושאי הדף">
      <button type="button" class="topic" role="tab" data-panel="system" aria-controls="panel-system" aria-selected="true">
        <span class="topic-icon" aria-hidden="true">🧭</span>
        <span class="topic-title">איך עובדת המערכת</span>
        <span class="topic-text">יומן, תוכנית שבועית, דיווח ושעון</span>
      </button>
      <button type="button" class="topic" role="tab" data-panel="types" aria-controls="panel-types" aria-selected="false">
        <span class="topic-icon" aria-hidden="true">🏃</span>
        <span class="topic-title">סוגי אימונים</span>
        <span class="topic-text">השיטה שלי והסבר על כל סוג אימון</span>
      </button>
    </div>

    <section class="panel" id="panel-system" role="tabpanel">
      <h2>איך עובדת המערכת</h2>
      <p class="lead">לוחצים על נושא כדי לראות את הפירוט.</p>
      <div class="acc-list">
        {
          systemItems.map((item) => (
            <details class="acc" id={item.id}>
              <summary>
                <span class="acc-icon" aria-hidden="true">{item.icon}</span>
                <span class="acc-text">
                  <strong>{item.title}</strong>
                  <span>{item.summary}</span>
                </span>
                <span class="acc-chev" aria-hidden="true">▾</span>
              </summary>
              <div class="acc-body">
                <AppBlocks blocks={item.blocks} />
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <section class="panel" id="panel-types" role="tabpanel" hidden>
      <h2>סוגי האימונים</h2>
      <section class="prep" aria-labelledby="prep-title" id="quality-prep">
        <h3 id="prep-title">הכנה לאימון איכות</h3>
        <AppBlocks blocks={qualityPrep} />
      </section>
      <p class="lead">לוחצים על סוג אימון כדי לקרוא על השיטה שלי ועל האימון עצמו.</p>
      <div class="acc-list">
        {
          trainingTypes.map((item) => (
            <details class="acc" id={item.id}>
              <summary>
                <span class="acc-icon" aria-hidden="true">{item.icon}</span>
                <span class="acc-text">
                  <strong>{item.title}</strong>
                  <span>{item.summary}</span>
                </span>
                <span class="acc-chev" aria-hidden="true">▾</span>
              </summary>
              <div class="acc-body">
                <AppBlocks blocks={item.blocks} />
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <p class="help">
      שאלה על אימון? <a href="https://wa.me/972526982993" rel="noopener">וואטסאפ 052-6982993</a>
    </p>
  </section>
</BaseLayout>

<dialog id="lightbox" class="lightbox" aria-label="תמונה מוגדלת">
  <button type="button" class="lightbox-close" aria-label="סגירה">×</button>
  <img id="lightbox-img" src="" alt="" />
</dialog>

<script>
  // הגדלת תמונה בלחיצה: חלון מלא, נסגר בלחיצה על התמונה או הרקע, על כפתור הסגירה או ב-Esc
  const box = document.getElementById("lightbox") as HTMLDialogElement | null;
  const boxImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest<HTMLElement>("[data-zoom]");
    if (btn && box && boxImg) {
      boxImg.src = btn.dataset.zoom ?? "";
      boxImg.alt = btn.dataset.alt ?? "";
      box.showModal();
      return;
    }
    if (box && box.open && (target === box || target.id === "lightbox-img" || target.classList.contains("lightbox-close"))) {
      box.close();
    }
  });
</script>

<script>
  // החלפת לשונית בין שני הריבועים. קישור ישיר (#hills, #calendar) פותח את הלשונית והפריט הרלוונטיים.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".topic"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>(".panel"));

  function showPanel(name: string) {
    panels.forEach((p) => {
      p.hidden = p.id !== `panel-${name}`;
    });
    tabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.panel === name)));
  }

  tabs.forEach((t) =>
    t.addEventListener("click", () => {
      showPanel(t.dataset.panel ?? "system");
      document.getElementById(`panel-${t.dataset.panel}`)?.scrollIntoView({ behavior: "smooth", block: "start" });
    })
  );

  const hash = location.hash.replace("#", "");
  const target = hash ? document.getElementById(hash) : null;
  if (target) {
    const panel = target.closest<HTMLElement>(".panel");
    if (panel) showPanel(panel.id.replace("panel-", ""));
    if (target instanceof HTMLDetailsElement) target.open = true;
    target.scrollIntoView();
  }
</script>

<style>
  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    overflow: auto;
  }
  .lightbox::backdrop {
    background: rgba(8, 12, 26, 0.9);
  }
  .lightbox img {
    display: block;
    margin: 0 auto;
    min-width: min(100%, 1100px);
    max-width: none;
    width: min(100%, 1900px);
    height: auto;
    cursor: zoom-out;
  }
  .lightbox-close {
    position: fixed;
    top: 12px;
    inset-inline-start: 12px;
    z-index: 2;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid #fff;
    background: #b34700;
    color: #fff;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
  }

  .app {
    max-width: 900px;
  }
  .lead {
    color: var(--color-text-muted);
  }
  .login-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin: var(--space-3, 1rem) 0 0.5rem;
    padding: 1rem 1.25rem;
    border: 2px solid #b34700;
    border-radius: 16px;
    background: var(--color-surface, #fff);
  }
  .login-box div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .login-box span {
    color: var(--color-text-muted);
  }
  .first-time {
    margin-top: 0;
    font-size: 0.95rem;
  }
  h2 {
    margin-top: var(--space-5, 2.5rem);
  }
  .prep {
    margin-top: var(--space-3, 1rem);
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-border, #e4e7ec);
    border-inline-start: 4px solid #b34700;
    border-radius: 14px;
    background: var(--color-surface, #fff);
  }
  .prep + .lead {
    margin-top: var(--space-3, 1rem);
  }
  .prep h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }
  .topics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3, 1rem);
    margin: var(--space-4, 1.5rem) 0;
  }
  .topic {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 190px;
    padding: 1.2rem 1rem;
    border: 2px solid var(--color-border, #e4e7ec);
    border-radius: 20px;
    background: var(--color-surface, #fff);
    color: inherit;
    font: inherit;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .topic:hover {
    border-color: #b34700;
  }
  .topic:focus-visible {
    outline: 3px solid #b34700;
    outline-offset: 2px;
  }
  .topic[aria-selected="true"] {
    border-color: #b34700;
    box-shadow: 0 0 0 3px rgba(179, 71, 0, 0.15);
  }
  .topic-icon {
    font-size: 2.6rem;
    line-height: 1;
  }
  .topic-title {
    font-size: 1.3rem;
    font-weight: 800;
  }
  .topic-text {
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }
  .panel[hidden] {
    display: none;
  }
  @media (max-width: 520px) {
    .topic {
      min-height: 160px;
    }
    .topic-title {
      font-size: 1.1rem;
    }
  }
  .acc-list {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-top: var(--space-3, 1rem);
  }
  .acc {
    border: 1px solid var(--color-border, #e4e7ec);
    border-radius: 14px;
    background: var(--color-surface, #fff);
  }
  .acc[open] {
    border-color: #b34700;
  }
  .acc > summary {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.1rem;
    cursor: pointer;
    list-style: none;
  }
  .acc > summary::-webkit-details-marker {
    display: none;
  }
  .acc > summary:focus-visible {
    outline: 3px solid #b34700;
    outline-offset: 2px;
    border-radius: 12px;
  }
  .acc-icon {
    font-size: 1.6rem;
    line-height: 1;
  }
  .acc-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .acc-text span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .acc-chev {
    color: #b34700;
    transition: transform 0.15s ease;
  }
  .acc[open] .acc-chev {
    transform: rotate(180deg);
  }
  .acc-body {
    padding: 0 1.1rem 1.1rem;
  }
  .help {
    margin-top: var(--space-4, 1.5rem);
  }
</style>

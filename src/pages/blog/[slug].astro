---
// תבנית פוסט בודד בבלוג.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatHebrewDate(date: Date) {
  return new Intl.DateTimeFormat("he-IL", { day: "numeric", month: "long", year: "numeric" }).format(date);
}

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.publishDate.toISOString(),
    "author": { "@type": "Person", "name": "תומר אלמוג" },
  },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}/`}
  ogType="article"
  ogImage={post.data.ogImage}
  schema={schema}
>
  <article class="container post">
    <p class="date">{formatHebrewDate(post.data.publishDate)}</p>
    <h1>{post.data.title}</h1>
    {post.data.ogImage && (
      <img class="post-image" src={post.data.ogImage} alt={post.data.title} />
    )}
    <div class="prose">
      <Content />
    </div>
    <div class="post-cta">
      <p>רוצה תוכנית אישית לריצה שלך?</p>
      <a href="/training-plans/" class="btn btn-primary">תוכניות אימון אונליין</a>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--space-5) var(--space-6);
    max-width: 720px;
  }

  .date {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-1);
  }

  .post-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    margin-block: var(--space-3);
  }

  .prose {
    margin-top: var(--space-3);
    line-height: 1.75;
  }

  .prose :global(h2) {
    margin-top: var(--space-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: 1.4em;
    margin-bottom: var(--space-2);
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .post-cta {
    margin-top: var(--space-5);
    padding: var(--space-3);
    background: var(--color-gray-50);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .post-cta p {
    margin-bottom: var(--space-2);
    font-weight: 600;
  }
</style>

---
// הסכם ליווי ריצה אישי, גרסה 2026-10-20. עמוד תפעולי: לא בתפריט, לא במפת האתר.
// מגיעים אליו מתיבת האישור בשאלון הקליטה או בקישור ישיר. הנוסח עצמו ב-src/data/agreement-2026-10-20.md
// (גרסה חדשה = קובץ חדש + עדכון AGREEMENT_VERSION כאן ובשאלון, כדי שאישורים ישנים יישארו מול הנוסח שאושר).
import BaseLayout from "../layouts/BaseLayout.astro";
import { Content } from "../data/agreement-2026-10-20.md";

const AGREEMENT_VERSION = "2026-10-20";
---

<BaseLayout
  title="הסכם ליווי ריצה אישי"
  description="הסכם ליווי ריצה אישי של ENDURO, תומר אלמוג: השירות, בריאות ובטיחות, תשלום, סיום ופרטיות."
  canonicalPath="/agreement/"
  noindex
>
  <section class="hero">
    <div class="container hero-inner">
      <h1>הסכם ליווי ריצה אישי</h1>
      <p class="version">גרסה {AGREEMENT_VERSION}</p>
    </div>
  </section>

  <section class="container section">
    <article class="agreement">
      <Content />
    </article>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-navy-950), var(--color-navy-900));
    color: var(--color-white);
  }
  .hero-inner {
    padding-block: var(--space-6) var(--space-5);
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }
  .hero h1 {
    color: var(--color-white);
  }
  .version {
    margin: 0;
    opacity: 0.8;
  }
  .agreement {
    max-width: 760px;
    margin-inline: auto;
    line-height: 1.75;
  }
  .agreement :global(h2) {
    font-size: 1.25rem;
    margin-top: var(--space-4);
  }
  .agreement :global(ol),
  .agreement :global(ul) {
    padding-inline-start: 1.4rem;
  }
  .agreement :global(li) {
    margin-block: 0.35rem;
  }
  .agreement :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--space-2);
  }
  .agreement :global(th),
  .agreement :global(td) {
    border: 1px solid var(--color-gray-300);
    padding: 0.5rem 0.75rem;
    text-align: right;
  }
  .agreement :global(th) {
    background: var(--color-gray-50);
  }
</style>

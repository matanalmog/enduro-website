---
import BaseLayout from "../layouts/BaseLayout.astro";

const sections = [
  {
    title: "1. השירות",
    items: [
      "המאמן יספק תוכנית אימון אישית שבועית בהתאם למסלול שנבחר, למטרות המתאמן, למידע שמסר ולשיקול דעת מקצועי.",
      "השירות עשוי לכלול תקשורת שוטפת ב-WhatsApp, שיחות בתיאום, שימוש ב-Final Surge, קבוצת ENDURO ומפגשים קבוצתיים מזדמנים. היקף השירות המדויק נקבע לפי המסלול שנבחר.",
      "תוכניות ועדכונים נמסרים לשימושו האישי של המתאמן בלבד. אין להעבירם לאחרים או לעשות בהם שימוש מסחרי ללא אישור בכתב.",
      "המאמן ישתדל להשיב בזמן סביר בשעות הפעילות. מועדי אימונים, שיחות או מפגשים עשויים להשתנות בתיאום.",
    ],
  },
  {
    title: "2. בריאות, בטיחות ואחריות המתאמן",
    items: [
      "לפני תחילת הליווי המתאמן ימלא שאלון קליטה והצהרת בריאות.",
      "המתאמן מתחייב למסור מידע נכון, מלא ועדכני, ולעדכן מיד על כאב, פציעה, מחלה, הריון, שינוי בתרופות, מגבלה רפואית או כל שינוי שעשוי להשפיע על האימון.",
      "המאמן רשאי לבקש אישור רפואי או בדיקת מאמץ כתנאי להתחלה או להמשך האימונים.",
      "במקרה של כאב חד, החמרה או תסמין מדאיג, המתאמן יפסיק את האימון ויפנה לייעוץ רפואי מתאים. במקרה חירום יש לפנות לשירותי החירום.",
      "המתאמן אחראי לבצע את האימונים בהתאם להנחיות ובסביבה בטוחה. המאמן אינו גורם רפואי ואינו מתחייב לתוצאה מסוימת או להיעדר פציעה.",
    ],
  },
  {
    title: "3. תקשורת, נתוני אימון ושינויים בתוכנית",
    items: [
      "המתאמן יעדכן את המאמן על ביצוע האימונים, תחושות, מאמץ, כאב או מגבלה רלוונטית. מידע חסר או מאוחר עלול להשפיע על איכות ההתאמה של התוכנית.",
      "המאמן רשאי להתאים, לדחות, להחליף או לבטל אימון מטעמי עומס, בריאות, בטיחות, זמינות או התאמה למטרה.",
      "נתוני שעון, דופק, קצב, GPS ומדדים אחרים עלולים להיות חלקיים או שגויים; הם משמשים כלי עזר ואינם אבחנה רפואית.",
    ],
  },
  {
    title: "4. תשלום",
    items: [
      "החיוב חודשי בכרטיס אשראי ב-29 בחודש עבור החודש הבא. המחירים כוללים מע״מ.",
      "חיוב שנכשל ולא הוסדר בתוך 7 ימים עשוי להביא להשהיית השירות עד להסדרת התשלום.",
      "שינוי במחיר יימסר לפחות 30 יום מראש.",
      "מסלולים ומחירים מפורטים בסוף ההסכם. אם הוסכם בכתב על מסלול או מחיר אחר, ההסכמה הכתובה המאוחרת תגבר.",
    ],
  },
  {
    title: "5. סיום וביטול",
    items: [
      "אפשר למסור הודעת ביטול בכתב ב-WhatsApp או בדוא״ל. הודעה שנמסרה עד ה-28 בחודש תסיים את הליווי בסוף אותו חודש ללא חיוב לחודש הבא.",
      "הודעה שנמסרה מה-29 בחודש ואילך, לאחר שהחיוב לחודש הבא כבר בוצע, תסיים את הליווי בסוף החודש שכבר חויב, בכפוף לכל זכות ביטול או החזר הקבועה בדין.",
      "המאמן רשאי לסיים את הליווי בהודעה של 30 יום, או באופן מיידי במקרה של אי-תשלום, מסירת מידע מטעה, התנהגות פוגענית או סיכון בריאותי משמעותי שאינו מאפשר המשך בטוח.",
    ],
  },
  {
    title: "6. פרטיות ושימוש במידע",
    items: [
      "פרטי הקשר, שאלון הקליטה, נתוני האימון והמידע הבריאותי שנמסר ישמשו לצורך הליווי, התאמת התוכנית, תקשורת, תפעול וחיוב בלבד.",
      "המידע עשוי להישמר במערכות העסק, ובהן Google Drive, Final Surge, WhatsApp, דוא״ל, מערכת הניהול וספק הסליקה. הוא לא יימכר או ישמש למטרה אחרת ללא הסכמה, אלא אם הדבר נדרש לפי דין.",
    ],
  },
  {
    title: "7. אישור אלקטרוני ותיעוד",
    items: [
      "האישור מתבצע באמצעות סימון תיבת הסכמה ושליחת שאלון הקליטה.",
      "לצורך הוכחת האישור יישמרו שם המתאמן, כתובת הדוא״ל, תאריך ושעת השליחה, גרסת ההסכם והצהרת ההסכמה שנמסרה.",
    ],
  },
];

const plans = [
  ["מתחילים, עד 10 ק״מ", "360 ₪"],
  ["חצי מרתון", "410 ₪"],
  ["מרתון", "460 ₪"],
  ["אולטרה", "500 ₪"],
];
---

<BaseLayout
  title="הסכם ליווי ריצה אישי"
  description="הסכם ליווי הריצה האישי של ENDURO וספורט4יו."
  canonicalPath="/agreement/"
  noindex={true}
>
  <main class="agreement-page">
    <section class="agreement-hero">
      <div class="agreement-shell">
        <p class="eyebrow">ENDURO · SPORT4YOU</p>
        <h1>הסכם ליווי ריצה אישי</h1>
        <p class="version">גרסה 2026-10-20</p>
      </div>
    </section>

    <section class="agreement-shell agreement-card">
      <p>
        בין <strong>תומר אלמוג (ENDURO / SPORT4YOU)</strong> (להלן: "המאמן"), לבין
        המתאמן/ת שפרטיו/ה נמסרו בשאלון הקליטה (להלן: "המתאמן").
      </p>
      <p class="approval-note">
        אישור ההסכם בטופס המקוון מהווה אישור לכך שהמתאמן קרא את ההסכם, הבין אותו
        והסכים לתנאיו. למתאמן תישמר אפשרות לקבל עותק מן הנוסח שאושר.
      </p>

      {sections.map((section) => (
        <section class="agreement-section">
          <h2>{section.title}</h2>
          <ol>
            {section.items.map((item, index) => (
              <li>
                {section.title.startsWith("2.") && index === 0 ? (
                  <>לפני תחילת הליווי המתאמן ימלא <a href="/questionnaire/">שאלון קליטה והצהרת בריאות</a>.</>
                ) : item}
              </li>
            ))}
          </ol>
        </section>
      ))}

      <section class="agreement-section">
        <h2>מסלולים ומחירים</h2>
        <div class="price-table" role="table" aria-label="מסלולים ומחירים">
          <div class="price-row price-head" role="row">
            <span role="columnheader">מסלול</span><span role="columnheader">מחיר חודשי</span>
          </div>
          {plans.map(([name, price]) => (
            <div class="price-row" role="row">
              <span role="cell">{name}</span><strong role="cell">{price}</strong>
            </div>
          ))}
        </div>
        <p class="billing-note">המחירים כוללים מע״מ. החיוב מתבצע ב-29 בחודש עבור החודש הבא, בכפוף לסעיפים 4–5.</p>
      </section>
    </section>
  </main>
</BaseLayout>

<style>
  .agreement-page { background: #f5f5ef; padding-bottom: clamp(3rem, 8vw, 6rem); }
  .agreement-shell { width: min(920px, calc(100% - 2rem)); margin-inline: auto; }
  .agreement-hero { background: linear-gradient(145deg, #10251e, #1e4839); color: white; padding: clamp(3rem, 8vw, 6rem) 0; }
  .eyebrow { margin: 0 0 .5rem; color: #b9d8c7; font-weight: 800; letter-spacing: .08em; }
  h1 { margin: 0; font-size: clamp(2.2rem, 7vw, 4.8rem); line-height: 1; }
  .version { display: inline-flex; margin: 1.25rem 0 0; padding: .45rem .85rem; border: 1px solid rgba(255,255,255,.3); border-radius: 999px; }
  .agreement-card { margin-top: -2rem; background: white; border: 1px solid #d8ddd7; border-radius: 1.5rem; padding: clamp(1.25rem, 5vw, 3.5rem); box-shadow: 0 1.2rem 3rem rgba(16,37,30,.09); font-size: 1.05rem; line-height: 1.85; }
  .agreement-card > p:first-child { margin-top: 0; }
  .approval-note { background: #eaf3ed; border-right: .3rem solid #356b55; padding: 1rem 1.2rem; border-radius: .75rem; }
  .agreement-section { padding-top: 1.2rem; }
  .agreement-section + .agreement-section { border-top: 1px solid #e5e8e3; margin-top: 1.25rem; }
  h2 { color: #17342a; font-size: clamp(1.35rem, 4vw, 1.8rem); margin: 0 0 .7rem; }
  ol { margin: 0; padding-right: 1.4rem; }
  li { padding-right: .3rem; margin-bottom: .45rem; }
  a { color: #356b55; font-weight: 700; }
  .price-table { border: 1px solid #d9ddd8; border-radius: 1rem; overflow: hidden; }
  .price-row { display: grid; grid-template-columns: 1fr auto; gap: 1rem; padding: .8rem 1rem; }
  .price-row + .price-row { border-top: 1px solid #e4e7e2; }
  .price-head { background: #17342a; color: white; font-weight: 800; }
  .billing-note { margin-bottom: 0; font-weight: 700; color: #3d4c46; }
  @media (max-width: 560px) { .agreement-shell { width: min(100% - 1rem, 920px); } .agreement-card { border-radius: 1rem; } }
</style>

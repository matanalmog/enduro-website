---
// תמונת סעיף — תמונות אמיתיות מהמאגר (לא stock), בעיצוב אחיד לאורך האתר.
export interface Props {
  src: string;
  alt: string;
  caption?: string;
  eager?: boolean;
}

const { src, alt, caption, eager = false } = Astro.props;
---

<figure class="section-photo">
  <img src={src} alt={alt} loading={eager ? "eager" : "lazy"} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .section-photo {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .section-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .section-photo figcaption {
    padding: var(--space-1) var(--space-2);
    font-size: 0.82rem;
    color: var(--color-text-muted);
    background: var(--color-gray-50);
  }
</style>

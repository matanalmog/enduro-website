---
// כותרת עליונה — ניווט ראשי לפי מיפוי האתר (סעיף 2 באפיון).
// תפריטי משנה לעמודי "כפילות עירונית" (מאמן כושר ילדים / אישי) שנשארים נפרדים בכוונה.
export interface NavChild {
  label: string;
  href: string;
  groupLabel?: string;
}

export interface NavItem {
  label: string;
  href: string;
  children?: NavChild[];
}

const navItems: NavItem[] = [
  { label: "לוח תחרויות", href: "/races/" },
  {
    label: "תוכניות אימון אונליין",
    href: "/training-plans/",
    children: [
      { label: "מתחילים עד 10 ק\"מ", href: "/training-plans/beginners/" },
      { label: "חצי מרתון", href: "/training-plans/half-marathon/" },
      { label: "מרתון", href: "/training-plans/marathon/" },
      { label: "אולטרה מרתון", href: "/training-plans/ultra-marathon/" },
      { label: "הכנה למרתון תל אביב", href: "/tel-aviv-marathon/" },
    ],
  },
  {
    label: "מאמן כושר אישי",
    href: "/personal-coaching/",
    children: [
      { label: "שיפור יכולות אתלטיות לכדורגלנים", href: "/kids-coaching/football-conditioning/", groupLabel: "יכולות אתלטיות" },
      { label: "מאמן כושר אישי לילדים", href: "/kids-coaching/ramat-hasharon/", groupLabel: "ילדים" },
      { label: "מאמן כושר אישי לילדים בהרצליה", href: "/kids-coaching/herzliya/" },
      { label: "מאמן כושר אישי לילדים בתל אביב", href: "/kids-coaching/tel-aviv/" },
      { label: "הכנה לכיתות ספורט", href: "/kids-coaching/ramat-hasharon/" },
      { label: "קבוצות אתלטיקה", href: "/kids-coaching/athletics-groups/" },
      { label: "מאמן כושר אישי לגיל השלישי", href: "/personal-coaching/seniors/", groupLabel: "גיל שלישי" },
      { label: "מאמן כושר אישי למבוגרים", href: "/personal-coaching/ramat-hasharon/", groupLabel: "אימון למבוגרים" },
      { label: "מאמן כושר אישי בהרצליה", href: "/personal-coaching/herzliya/" },
      { label: "מאמן כושר אישי בתל אביב", href: "/personal-coaching/tel-aviv/" },
    ],
  },
  {
    label: "קבוצות ריצה",
    href: "/groups/",
    children: [
      { label: "רמת השרון", href: "/groups/ramat-hasharon/" },
      { label: "מתחילים", href: "/groups/beginners/" },
      { label: "עסקים וארגונים", href: "/groups/business/" },
      { label: "שטח והרים", href: "/groups/trail/" },
      { label: "תל אביב", href: "/groups/tel-aviv/" },
    ],
  },
  { label: "בלוג", href: "/blog/" },
  { label: "אודות", href: "/about-me/" },
];

// CTA ראשי תמיד מצביע לטופס בדף הבית (#lead-form): עוגן בדף הבית עצמו,
// קישור מלא לדף הבית עם העוגן משאר הדפים (ראו סעיף 1 באפיון).
const isHome = Astro.url.pathname === "/";
const ctaHref = isHome ? "#lead-form" : "/#lead-form";
---

<header class="site-header">
  <div class="container header-inner">
    <div class="logo-group">
      <a href="/" class="logo" aria-label="Enduro, דף הבית">
        <img src="/images/logo/enduro-icon-96.png" alt="" width="44" height="44" class="logo-icon" />
        <span class="logo-mark">ENDURO</span>
      </a>
      <div class="logo-contact">
        <span class="logo-name">תומר אלמוג</span>
        <a href="tel:+972526982993" class="logo-phone" aria-label="התקשרו עכשיו: 052-6982993">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span dir="ltr">052-6982993</span>
        </a>
      </div>
    </div>

    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="visually-hidden">פתיחת תפריט ניווט</span>
      <span class="nav-toggle-bars" aria-hidden="true"></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="ניווט ראשי">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li class:list={["nav-item", { "has-children": item.children }]}>
            <a href={item.href} class="nav-link">
              {item.label}
              {item.children && <span class="chevron" aria-hidden="true">▾</span>}
            </a>
            {item.children && (
              <ul class="submenu">
                {item.children.map((child) => (
                  <>
                    {child.groupLabel && (
                      <li class="submenu-group-label" aria-hidden="true">{child.groupLabel}</li>
                    )}
                    <li>
                      <a href={child.href}>{child.label}</a>
                    </li>
                  </>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <a href={ctaHref} class="btn btn-primary nav-cta">בדקו התאמה לתוכנית אישית &larr;</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-header-bg);
    color: var(--color-header-text);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    gap: var(--space-3);
  }

  .logo-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-2);
  }

  .logo {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-header-text);
    line-height: 1.1;
  }

  .logo-icon {
    border-radius: 50%;
    flex: none;
    object-fit: cover;
    box-shadow: var(--shadow-sm);
  }

  .logo-mark {
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: 0.02em;
    color: var(--color-brand);
  }

  .logo-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding-inline-start: var(--space-2);
    border-inline-start: 1px solid var(--color-navy-700);
  }

  .logo-name {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-gray-300);
    white-space: nowrap;
  }

  .logo-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    text-decoration: none;
    color: var(--color-gray-300);
    font-size: 0.75rem;
    font-weight: 700;
    width: fit-content;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .logo-phone:hover,
  .logo-phone:focus-visible {
    color: var(--color-brand);
  }

  .nav-toggle {
    display: none;
    background: transparent;
    border: none;
    color: var(--color-header-text);
    padding: var(--space-1);
    cursor: pointer;
  }

  .nav-toggle-bars,
  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    display: block;
    width: 24px;
    height: 2px;
    background: currentColor;
    position: relative;
    transition: transform 0.15s ease;
  }

  .nav-toggle-bars::before {
    content: "";
    position: absolute;
    top: -7px;
  }

  .nav-toggle-bars::after {
    content: "";
    position: absolute;
    top: 7px;
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-3);
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    text-decoration: none;
    color: var(--color-header-text);
    font-weight: 600;
    font-size: 0.95rem;
    padding: var(--space-1) 0;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-brand);
  }

  .chevron {
    font-size: 0.7rem;
  }

  .submenu {
    list-style: none;
    margin: 0;
    padding: var(--space-1) 0;
    position: absolute;
    inset-inline-start: 0;
    top: 100%;
    background: var(--color-navy-800);
    border-radius: var(--radius-sm);
    min-width: 240px;
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  }

  .nav-item.has-children:hover .submenu,
  .nav-item.has-children:focus-within .submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .submenu a {
    display: block;
    padding: 0.6rem var(--space-2);
    text-decoration: none;
    color: var(--color-gray-300);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .submenu a:hover,
  .submenu a:focus-visible {
    color: var(--color-white);
    background: var(--color-navy-700);
  }

  .submenu-group-label {
    padding: 0.5rem var(--space-2) 0.25rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-gold-500);
    border-top: 1px solid var(--color-navy-700);
    margin-top: 0.25rem;
  }

  .submenu li:first-child.submenu-group-label {
    border-top: none;
    margin-top: 0;
  }

  .nav-cta {
    padding: 0.55rem 1.25rem;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  /* רוחבי מסך בינוניים (לפטופים נפוצים) — התפריט המלא עדיין מוצג (לא עובר לתפריט המבורגר),
     אז פה בדיוק צריך לפנות מקום: מצמצמים רווחים. */
  @media (max-width: 1300px) {
    .nav-list {
      gap: var(--space-2);
    }

    .primary-nav {
      gap: var(--space-3);
    }

    .nav-cta {
      padding: 0.55rem 1rem;
    }
  }

  /* מ-1220px ומטה: גם עם כל הצמצום למעלה, 6 פריטי ניווט + כפתור CTA כבר לא נכנסים
     בשורה אחת בלי לדחוס את הטקסט. עדיף לעבור לתפריט המבורגר (הבדוק והנגיש) מוקדם
     יותר, ולא לכווץ עוד את טקסט הניווט. */
  @media (max-width: 1220px) {
    .nav-toggle {
      display: block;
    }

    .primary-nav {
      position: fixed;
      inset-inline: 0;
      top: var(--header-height);
      bottom: 0;
      background: var(--color-header-bg);
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-3);
      box-sizing: border-box;
      overflow-x: hidden;
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.2s ease;
    }

    [dir="rtl"] .primary-nav {
      transform: translateX(-100%);
    }

    .primary-nav.is-open {
      transform: translateX(0);
    }

    .nav-list {
      flex-direction: column;
      gap: 0;
    }

    .nav-item {
      border-bottom: 1px solid var(--color-navy-700);
    }

    .nav-link {
      padding: var(--space-2) 0;
      justify-content: space-between;
    }

    .submenu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      background: transparent;
      display: none;
      padding-inline-start: var(--space-2);
    }

    .nav-item.subnav-open .submenu {
      display: block;
    }

    .nav-cta {
      margin-top: var(--space-2);
      text-align: center;
    }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("primary-nav");

  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });

  // במובייל: קליק על פריט עם תפריט-משנה פותח/סוגר אותו במקום לנווט מיד
  if (window.matchMedia("(max-width: 1220px)").matches) {
    document.querySelectorAll(".nav-item.has-children > .nav-link").forEach((link) => {
      link.addEventListener("click", (event) => {
        const parent = link.closest(".nav-item");
        if (parent && !parent.classList.contains("subnav-open")) {
          event.preventDefault();
          document
            .querySelectorAll(".nav-item.subnav-open")
            .forEach((el) => el.classList.remove("subnav-open"));
          parent.classList.add("subnav-open");
        }
      });
    });
  }
</script>

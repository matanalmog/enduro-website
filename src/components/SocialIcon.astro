---
export interface Props {
  name: "facebook" | "instagram" | "youtube" | "tiktok";
}

const { name } = Astro.props;
---

{name === "facebook" && (
  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
    <path d="M13.5 21v-7.5h2.5l.4-3H13.5V8.5c0-.87.24-1.46 1.5-1.46h1.6V4.35C16.3 4.24 15.32 4 14.2 4 11.87 4 10.3 5.4 10.3 8.2v2.3H7.8v3h2.5V21h3.2Z" />
  </svg>
)}
{name === "instagram" && (
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
  </svg>
)}
{name === "youtube" && (
  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
    <path d="M21.6 7.6a2.7 2.7 0 0 0-1.9-1.9C18 5.2 12 5.2 12 5.2s-6 0-7.7.5A2.7 2.7 0 0 0 2.4 7.6 28 28 0 0 0 2 12a28 28 0 0 0 .4 4.4 2.7 2.7 0 0 0 1.9 1.9c1.7.5 7.7.5 7.7.5s6 0 7.7-.5a2.7 2.7 0 0 0 1.9-1.9A28 28 0 0 0 22 12a28 28 0 0 0-.4-4.4ZM10 15V9l5.2 3-5.2 3Z" />
  </svg>
)}
{name === "tiktok" && (
  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
    <path d="M16.5 3h-2.7v12.2a2.6 2.6 0 1 1-2.1-2.55v-2.75a5.35 5.35 0 1 0 4.8 5.3V8.9a6.8 6.8 0 0 0 3.9 1.24V7.44A4.1 4.1 0 0 1 16.5 3Z" />
  </svg>
)}

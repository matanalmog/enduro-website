---
// כותרת עליונה לעמודי ההכנה למרוץ ולמדריכי המרוצים.
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="ph-hero">
  <div class="container">
    <div class="ph-eyebrow">{eyebrow}</div>
    <h1>{title}</h1>
    <p>{lead}</p>
  </div>
</section>

<style>
  .ph-hero {
    background: linear-gradient(180deg, var(--color-navy-950), var(--color-navy-900));
    color: var(--color-white);
    text-align: center;
    padding-block: var(--space-6) var(--space-5);
  }
  .ph-eyebrow {
    color: var(--color-gold-500);
    font-weight: 700;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
  }
  h1 {
    color: var(--color-white);
    margin: 0.4rem 0;
  }
  p {
    color: var(--color-gray-300);
    max-width: 56ch;
    margin-inline: auto;
  }
</style>

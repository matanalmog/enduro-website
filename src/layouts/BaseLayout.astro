---
// תבנית עמוד בסיסית — כל עמוד באתר עובר דרך הרכיב הזה.
// אחראי על: H1 יחיד (באחריות התוכן בתוך ה-slot), meta title/description ייחודיים,
// canonical, Open Graph, JSON-LD (Schema.org), ו-favicon. ראו סעיף 4 באפיון (SEO).
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

export interface Props {
  /** Meta title — עד ~60 תווים, ייחודי לכל עמוד */
  title: string;
  /** Meta description — עד ~155 תווים, ייחודי לכל עמוד */
  description: string;
  /** נתיב קנוני יחסי, למשל "/training-plans/marathon/" */
  canonicalPath?: string;
  /** תמונת שיתוף ל-Open Graph / Twitter */
  ogImage?: string;
  ogType?: "website" | "article";
  /** למניעת אינדוקס (למשל עמודי תודה/טפסים) */
  noindex?: boolean;
  /** אובייקט/מערך JSON-LD אחד או יותר (LocalBusiness, Person, Review, FAQPage...) */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = "/images/action/tomer-elite-race-pack.jpg",
  ogType = "website",
  noindex = false,
  schema,
} = Astro.props;

const siteName = "Enduro | sport4you.co.il";
const siteUrl = "https://www.sport4you.co.il";
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const gaMeasurementId = "G-GFM3NPHDKY";
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="M_3Eod6ik9sd-mthA_EJvez_aVlb3Ztr0zFrTrel9MI" />

    <!-- Google Analytics (GA4) -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
    <script define:vars={{ gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", gaMeasurementId);
    </script>

    <!-- מקור פנייה: שומר ?src=... מכל עמוד ל-localStorage (30 יום), כדי שטפסי
         הלידים ידעו מאיפה הגיע המבקר גם אם הוא עבר בין עמודים לפני שמילא טופס. -->
    <script>
      (function () {
        try {
          const src = new URLSearchParams(window.location.search).get("src");
          if (src) {
            localStorage.setItem("enduro_lead_source", JSON.stringify({ value: src, ts: Date.now() }));
          }
        } catch {
          // localStorage לא זמין (למשל דפדפן פרטי) - ממשיכים בלי מעקב מקור
        }
      })();
    </script>

    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders:wght@400;600;800&family=Heebo:wght@300;400;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="he_IL" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="generator" content={Astro.generator} />

    {schemaList.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <a href="#main-content" class="skip-link">דלג לתוכן הראשי</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
